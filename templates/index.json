    "story": {
      "type": "gripfeet-brand-story",
      "settings": {
        "eyebrow": "Our story · Made in India",
        "heading": "A grip sock that finally feels like a sock.",
        "sig_name": "The Gripfeet team",
        "sig_sub": "Knit in India · Designed for everywhere",
        "cta_label": "Read our story",
        "cta_link": "/pages/our-story"
      },
      "blocks": {
        "p1": {
          "type": "paragraph",
          "settings": {
            "text": "Most grip socks fall into two camps — clinical and forgettable, or loud and over-sporty. We sat between them and built Gripfeet for the way people actually move: studios, hotel rooms, school runs, long flights, slow Sundays."
          }
        },
        "p2": {
          "type": "paragraph",
          "settings": {
            "text": "We knit ours in-house in India — Supima cotton up top and a 100% silicone grip pattern on the sole. A manufacturing depth most lifestyle brands have to import. The result is the first Made-in-India grip sock you'd genuinely wear out of the studio."
          }
        }
      },
      "block_order": [
        "p1",
        "p2"
      ]
    },
