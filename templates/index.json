    "story": {
      "type": "gripfeet-brand-story",
      "settings": {
        "eyebrow": "Our story · Made in India",
        "heading": "A grip sock that finally feels like a sock.",
        "body_1": "Most grip socks fall into two camps — clinical and forgettable, or loud and over-sporty. We sat between them and built Gripfeet for the way people actually move: studios, hotel rooms, school runs, long flights, slow Sundays.",
