    "story": {
      "type": "gripfeet-brand-story",
      "settings": {
        "eyebrow": "Our story \u00b7 Made in India",
        "heading": "A grip sock that finally feels like a sock.",
        "body_1": "Most grip socks fall into two camps \u2014 clinical and forgettable, or loud and over-sporty. We sat between them and built Gripfeet for the way people actually move: studios, hotel rooms, school runs, long flights, slow Sundays.",
        "body_2": "We knit ours in-house in India \u2014 Supima cotton up top, a 100% silicone grip pattern on the sole.",
        "sig_name": "The Gripfeet team",
        "sig_sub": "Knit in India \u00b7 Designed for everywhere"
      }
    },
