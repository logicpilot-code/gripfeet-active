{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<section class="gf-section gf-section--band">
  <div class="gf-wrap">
    <div class="gf-section-head">
      <div class="gf-section-head__left">
        <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="gf-h-section">
          {{ section.settings.heading }}
          {%- if section.settings.heading_italic != blank -%}
            <em class="gf-italic">{{ section.settings.heading_italic }}</em>
          {%- endif -%}
        </h2>
      </div>
      <div class="gf-section-head__right">
        {%- if section.settings.all_label != blank -%}
          <a href="{{ section.settings.all_link }}" class="gf-btn--link">
            {{ section.settings.all_label }}
            <svg class="gf-arrow-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="gf-product-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          <a
            class="gf-product"
            href="{{ block.settings.link }}"
            {{ block.shopify_attributes }}
          >
            <div class="gf-product__img-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w"
                  sizes="(max-width: 400px) 100vw, (max-width: 780px) 50vw, 25vw"
                  alt="{{ block.settings.image.alt | default: block.settings.name }}"
                  width="600" height="750"
                  loading="lazy"
                >
              {%- else -%}
                <div class="gf-ph{% if block.settings.ph_style == 'dark' %} gf-ph--dark{% elsif block.settings.ph_style == 'kids' %} gf-ph--kids{% endif %}" style="aspect-ratio:4/5">
                  <span class="gf-ph__label">[ {{ block.settings.name }} · {{ block.settings.pack | downcase }} ]</span>
                  <span class="gf-ph__corner">GF · PRODUCT</span>
                </div>
              {%- endif -%}

              {%- if block.settings.swatches != blank -%}
                <div class="gf-product__swatches" aria-hidden="true">
                  {%- assign swatch_list = block.settings.swatches | split: ',' -%}
                  {%- for swatch in swatch_list -%}
                    <span class="gf-product__swatch" style="background:{{ swatch | strip }}"></span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <button class="gf-product__wish" aria-label="Add to wishlist" onclick="event.preventDefault()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10Z"/></svg>
              </button>
              <button class="gf-product__quick-add" aria-label="Quick add" onclick="event.preventDefault()">
                Quick add — {{ block.settings.price }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
              </button>
            </div>

            <div class="gf-product__meta">
              <div>
                <div class="gf-product__name">{{ block.settings.name }}</div>
                <div class="gf-product__range">{{ block.settings.range }}</div>
              </div>
              <div class="gf-product__price">
                {%- if block.settings.price_was != blank -%}
                  <span class="gf-product__strike">{{ block.settings.price_was }}</span>
                {%- endif -%}
                {{ block.settings.price }}
              </div>
              <div class="gf-product__sub">{{ block.settings.color_note }} · {{ block.settings.pack }}</div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.sub_banner_title != blank -%}
      <div style="margin-top:48px">
        <div class="gf-sub-banner">
          <span class="gf-sub-banner__ico" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 4v4h-4"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 20v-4h4"/></svg>
          </span>
          <div class="gf-sub-banner__copy">
            <h4 class="gf-sub-banner__title">{{ section.settings.sub_banner_title }}</h4>
            <p class="gf-sub-banner__copy">{{ section.settings.sub_banner_desc }}</p>
          </div>
          <a href="{{ section.settings.sub_banner_link }}" class="gf-btn gf-btn--ghost">
            {{ section.settings.sub_banner_cta }}
            <svg class="gf-arrow-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GF Featured Products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow",          "label": "Eyebrow",            "default": "03 — Newly knit · Featured sets" },
    { "type": "text", "id": "heading",          "label": "Heading",            "default": "One pack" },
    { "type": "text", "id": "heading_italic",   "label": "Heading italic",     "default": "from every range." },
    { "type": "text", "id": "all_label",        "label": "See all label",      "default": "Shop all" },
    { "type": "url",  "id": "all_link",         "label": "See all link" },
    { "type": "header",  "content": "Subscribe & Save Banner" },
    { "type": "text", "id": "sub_banner_title", "label": "Banner title",       "default": "Subscribe & save 15% on every refill." },
    { "type": "text", "id": "sub_banner_desc",  "label": "Banner description", "default": "Pick a pack. Pick a cadence — every 2, 3 or 6 months. Skip or cancel anytime. Free shipping always." },
    { "type": "text", "id": "sub_banner_cta",   "label": "Banner CTA label",   "default": "How it works" },
    { "type": "url",  "id": "sub_banner_link",  "label": "Banner CTA link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image",       "label": "Product image (4:5 ratio)" },
        {
          "type": "select",
          "id": "ph_style",
          "label": "Placeholder style (if no image)",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark",  "label": "Dark (Crew)" },
            { "value": "kids",  "label": "Cream (Kids)" }
          ],
          "default": "light"
        },
        { "type": "text", "id": "name",        "label": "Product name",   "default": "Soft Studio" },
        { "type": "text", "id": "range",       "label": "Range",          "default": "Ankle · Mat Masters" },
        { "type": "text", "id": "pack",        "label": "Pack",           "default": "Set of 3 Pairs" },
        { "type": "text", "id": "color_note",  "label": "Colour story",   "default": "Warm Beige · Sage · Lavender" },
        { "type": "text", "id": "price",       "label": "Price",          "default": "₹699" },
        { "type": "text", "id": "price_was",   "label": "Was price (MRP)","default": "₹999" },
        { "type": "text", "id": "swatches",    "label": "Swatch hex codes (comma-separated)", "default": "#D9C9B3,#B6C5A8,#C7B9D8" },
        { "type": "url",  "id": "link",        "label": "Product link" }
      ]
    }
  ],
  "presets": [{
    "name": "GF Featured Products",
    "blocks": [
      { "type": "product", "settings": { "name": "Soft Studio",      "range": "Ankle · Mat Masters",   "pack": "Set of 3 Pairs", "color_note": "Warm Beige · Sage · Lavender", "price": "₹699", "price_was": "₹999", "swatches": "#D9C9B3,#B6C5A8,#C7B9D8" } },
      { "type": "product", "settings": { "name": "Court Classics",   "range": "Crew · Active Hold",    "pack": "Set of 2 Pairs", "color_note": "White & Black",                "price": "₹699", "price_was": "₹999", "swatches": "#FFFFFF,#0A0A0A",  "ph_style": "dark" } },
      { "type": "product", "settings": { "name": "Bare Neutrals",    "range": "Loafer · Invisible Grip","pack": "Set of 3 Pairs", "color_note": "Warm Beige · Grey · Dusty Brown","price": "₹599","price_was": "₹899", "swatches": "#D9C9B3,#A9ACA9,#7A6A57" } },
      { "type": "product", "settings": { "name": "Classic Stripe",   "range": "Kids · Lil Steps",      "pack": "Set of 3 Pairs", "color_note": "White · Red · Navy",           "price": "₹399", "price_was": "₹699", "swatches": "#FFFFFF,#9E2A2A,#1E2E4F", "ph_style": "kids" } }
    ]
  }]
}
{% endschema %}
