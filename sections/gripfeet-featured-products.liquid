{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}

<section class="section band" id="featured">
  <div class="wrap">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
      </div>
      <div class="right">
        <a href="{{ section.settings.all_link }}" class="btn-link">
          Shop all
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <div class="carousel" id="gf-featured-carousel">
      <div class="carousel-track" id="gf-carousel-track">
        {%- for block in section.blocks -%}
          {%- if block.type == "product" -%}
            {%- assign prod = block.settings.product -%}
            {%- if prod != blank -%}
              <a class="pcard" href="{{ prod.url }}" {{ block.shopify_attributes }}>
                <div class="pimg">
                  {%- if prod.compare_at_price > prod.price -%}
                    {%- assign off = prod.compare_at_price | minus: prod.price | times: 100 | divided_by: prod.compare_at_price -%}
                    <span class="save-tag">−{{ off }}%</span>
                  {%- endif -%}
                  {%- if prod.featured_image != blank -%}
                    <img src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title }}" width="600" height="600" loading="lazy" style="width:100%;height:100%;object-fit:cover">
                  {%- else -%}
                    <div class="ph" style="width:100%;height:100%">
                      <span class="ph-label">{{ prod.title }}</span>
                      <span class="ph-corner">{{ prod.handle | upcase | truncate: 8, "" }}</span>
                    </div>
                  {%- endif -%}
                </div>
                <div class="prange">{{ prod.type }}</div>
                <div class="pname">{{ prod.title }}</div>
                <div class="pprice">
                  {%- if prod.compare_at_price > prod.price -%}
                    <span class="was">₹{{ prod.compare_at_price | divided_by: 100 }}</span>
                  {%- endif -%}
                  ₹{{ prod.price | divided_by: 100 }}
                </div>
              </a>
            {%- else -%}
              <div class="pcard" {{ block.shopify_attributes }}>
                <div class="pimg">
                  <div class="ph" style="width:100%;height:100%">
                    <span class="ph-label">{{ block.settings.ph_label | default: 'Product placeholder' }}</span>
                    <span class="ph-corner">GF</span>
                  </div>
                </div>
                <div class="prange">{{ block.settings.range }}</div>
                <div class="pname">{{ block.settings.name }}</div>
                <div class="pprice"><span class="was">₹{{ block.settings.was }}</span>₹{{ block.settings.price }}</div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="carousel-foot">
        <div class="arrows">
          <button class="round-btn" id="gf-prev" aria-label="Previous">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="transform:scaleX(-1)"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </button>
          <button class="round-btn" id="gf-next" aria-label="Next">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </button>
        </div>
        <div class="progress"><span class="bar" id="gf-prog-bar"></span></div>
      </div>
    </div>

    {%- if section.settings.sub_banner_text != blank -%}
      <div style="margin-top:44px">
        <div class="sub-banner">
          <span class="icn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </span>
          <div class="copy">
            <h4>{{ section.settings.sub_banner_text }}</h4>
            <p>{{ section.settings.sub_banner_sub }}</p>
          </div>
          {%- if section.settings.sub_banner_cta != blank -%}
            <a href="{{ section.settings.sub_banner_link }}" class="btn btn-light">
              {{ section.settings.sub_banner_cta }}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  const track = document.getElementById("gf-carousel-track");
  const bar   = document.getElementById("gf-prog-bar");
  const prev  = document.getElementById("gf-prev");
  const next  = document.getElementById("gf-next");
  if (!track) return;

  function update() {
    const max = track.scrollWidth - track.clientWidth;
    const pct = max <= 0 ? 100 : (track.scrollLeft / max) * 100;
    const vis = Math.min(100, (track.clientWidth / track.scrollWidth) * 100);
    if (bar) { bar.style.left = (pct / 100 * (100 - vis)) + "%"; bar.style.width = vis + "%"; }
    if (prev) prev.disabled = track.scrollLeft <= 2;
    if (next) next.disabled = track.scrollLeft >= max - 2;
  }

  function scrollBy(dir) {
    const card = track.firstElementChild;
    const step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.5;
    track.scrollBy({ left: dir * step, behavior: "smooth" });
  }

  track.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  if (prev) prev.addEventListener("click", () => scrollBy(-1));
  if (next) next.addEventListener("click", () => scrollBy(1));
  update();
})();
</script>

{% schema %}
{
  "name": "Gripfeet — Featured Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow",        "label": "Eyebrow",       "default": "Newly knit · Featured sets" },
    { "type": "text", "id": "heading",        "label": "Heading",       "default": "Built for the way you move." },
    { "type": "url",  "id": "all_link",       "label": "All link" },
    { "type": "text", "id": "sub_banner_text","label": "Banner heading","default": "Subscribe & save 15% on every refill." },
    { "type": "text", "id": "sub_banner_sub", "label": "Banner subtext","default": "Pick a pack, pick a cadence — every 2, 3 or 6 months. Skip or cancel anytime." },
    { "type": "text", "id": "sub_banner_cta", "label": "Banner CTA",   "default": "How it works" },
    { "type": "url",  "id": "sub_banner_link","label": "Banner link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product",  "label": "Product" },
        { "type": "text",    "id": "name",      "label": "Fallback name",  "default": "Soft Studio Ankle" },
        { "type": "text",    "id": "range",     "label": "Fallback range", "default": "Ankle · Mat Masters" },
        { "type": "text",    "id": "price",     "label": "Fallback price", "default": "299" },
        { "type": "text",    "id": "was",       "label": "Fallback was",   "default": "499" },
        { "type": "text",    "id": "ph_label",  "label": "PH label",       "default": "Ankle sock · lifestyle shot" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "Gripfeet — Featured Products",
    "blocks": [
      { "type": "product", "settings": { "name": "Soft Studio Ankle",   "range": "Ankle · Mat Masters",    "price": "299", "was": "499" } },
      { "type": "product", "settings": { "name": "Active Crew Hold",     "range": "Crew · Active Hold",     "price": "299", "was": "499" } },
      { "type": "product", "settings": { "name": "Loafer Invisible",     "range": "Loafer · Invisible Grip","price": "249", "was": "399" } },
      { "type": "product", "settings": { "name": "Lil Steps Kids",       "range": "Kids · Lil Steps",       "price": "179", "was": "299" } }
    ]
  }]
}
{% endschema %}