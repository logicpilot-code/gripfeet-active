{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<section class="section band" id="featured">
  <div class="gf-wrap">
    <div class="gf-section-head">
      <div class="gf-section-head__left">
        <span class="gf-eyebrow"><span class="gf-dot"></span>{{ section.settings.eyebrow }}</span>
        <h2 class="gf-h-section" style="margin-top:14px">Built for the way<br>you move.</h2>
      </div>
      <div class="gf-section-head__right">
        <a href="{{ section.settings.all_link | default: '/collections/all' }}" class="gf-btn-link">{{ section.settings.all_label }} <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></a>
      </div>
    </div>

    <div class="gf-products-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- assign ph_class = '' -%}
          {%- if block.settings.ph_style == 'dark' -%}{%- assign ph_class = 'gf-ph--dark' -%}{%- endif -%}
          {%- if block.settings.ph_style == 'kids' -%}{%- assign ph_class = 'gf-ph--kids' -%}{%- endif -%}
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="gf-pcard" {{ block.shopify_attributes }}>
            <div class="gf-pcard__img">
              <span class="gf-pcard__save">Launch price</span>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.name }}" width="400" height="400" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
              {%- else -%}
                <div class="gf-ph {{ ph_class }}" style="width:100%;height:100%;min-height:280px">
                  <span class="gf-ph__label">{{ block.settings.name }}</span>
                  <span class="gf-ph__corner">GF</span>
                </div>
              {%- endif -%}
              <div class="gf-pcard__quick" onclick="this.closest('a').setAttribute('href', this.closest('a').href)">
                Quick add — {{ block.settings.price }}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
              </div>
            </div>
            {%- if block.settings.swatches != blank -%}
              <div class="gf-pcard__swatches">
                {%- assign sw_list = block.settings.swatches | split: ',' -%}
                {%- for sw in sw_list -%}
                  <span class="gf-pcard__sw" style="background:{{ sw | strip }}"></span>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="gf-pcard__range">{{ block.settings.range }}</div>
            <div class="gf-pcard__name">{{ block.settings.name }}</div>
            <div class="gf-pcard__price"><span class="gf-pcard__was">{{ block.settings.price_was }}</span>{{ block.settings.price }}</div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.sub_banner_title != blank -%}
      <div style="margin-top:44px">
        <div class="sub-banner">
          <span class="icn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 4v4h-4"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 20v-4h4"/></svg>
          </span>
          <div class="copy">
            <h4>{{ section.settings.sub_banner_title }}</h4>
            <p>{{ section.settings.sub_banner_desc }}</p>
          </div>
          <a href="{{ section.settings.sub_banner_link | default: '/pages/subscribe' }}" class="gf-btn gf-btn--light">{{ section.settings.sub_banner_cta }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
.gf-products-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(14px,1.6vw,24px)}
@media(max-width:1100px){.gf-products-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:760px){.gf-products-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:440px){.gf-products-grid{grid-template-columns:1fr}}
</style>
{% schema %}
{
  "name":"Gripfeet — Featured Products (Active)","tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Newly knit · Featured sets"},
    {"type":"text","id":"all_label","label":"See all label","default":"Shop all"},
    {"type":"url","id":"all_link","label":"See all link"},
    {"type":"text","id":"sub_banner_title","label":"Banner title","default":"Subscribe & save 15% on every refill."},
    {"type":"text","id":"sub_banner_desc","label":"Banner desc","default":"Pick a pack, pick a cadence — every 2, 3 or 6 months. Skip or cancel anytime. Free shipping, always."},
    {"type":"text","id":"sub_banner_cta","label":"Banner CTA","default":"How it works"},
    {"type":"url","id":"sub_banner_link","label":"Banner link"}
  ],
  "blocks":[{"type":"product","name":"Product card","settings":[
    {"type":"text","id":"name","label":"Product name","default":"Soft Studio"},
    {"type":"text","id":"range","label":"Range label","default":"Ankle · Mat Masters"},
    {"type":"text","id":"pack","label":"Pack","default":"Set of 3 Pairs"},
    {"type":"text","id":"color_note","label":"Colour note","default":"Warm Beige · Sage · Lavender"},
    {"type":"text","id":"price","label":"Price","default":"₹699"},
    {"type":"text","id":"price_was","label":"Was price","default":"₹999"},
    {"type":"text","id":"swatches","label":"Swatches (hex, comma-sep)","default":"#D9C9B3,#B6C5A8,#C7B9D8"},
    {"type":"select","id":"ph_style","label":"Placeholder style","options":[{"value":"light","label":"Light"},{"value":"dark","label":"Dark"},{"value":"kids","label":"Kids cream"}],"default":"light"},
    {"type":"image_picker","id":"image","label":"Product image"},
    {"type":"url","id":"link","label":"Link to product"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"Gripfeet — Featured Products (Active)","blocks":[
    {"type":"product","settings":{"name":"Soft Studio","range":"Ankle · Mat Masters","pack":"Set of 3 Pairs","color_note":"Warm Beige · Sage · Lavender","price":"₹699","price_was":"₹999","swatches":"#D9C9B3,#B6C5A8,#C7B9D8","ph_style":"light","link":"/products/soft-studio"}},
    {"type":"product","settings":{"name":"Court Classics","range":"Crew · Active Hold","pack":"Set of 2 Pairs","color_note":"White & Black","price":"₹699","price_was":"₹999","swatches":"#FFFFFF,#0A0A0A","ph_style":"dark","link":"/products/court-classics"}},
    {"type":"product","settings":{"name":"Bare Neutrals","range":"Loafer · Invisible Grip","pack":"Set of 3 Pairs","color_note":"Warm Beige · Grey · Dusty Brown","price":"₹599","price_was":"₹899","swatches":"#D9C9B3,#A9ACA9,#7A6A57","ph_style":"light","link":"/products/bare-neutrals"}},
    {"type":"product","settings":{"name":"Classic Stripe","range":"Kids · Lil Steps","pack":"Set of 3 Pairs","color_note":"White · Red · Navy","price":"₹399","price_was":"₹699","swatches":"#FFFFFF,#9E2A2A,#1E2E4F","ph_style":"kids","link":"/products/classic-stripe"}}
  ]}]
}
{% endschema %}
