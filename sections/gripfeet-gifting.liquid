{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<section class="gf-wrap gf-section">
  <div class="gf-gifting">
    <div class="gf-gifting__visual">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          srcset="{{ section.settings.image | image_url: width: 450 }} 450w, {{ section.settings.image | image_url: width: 900 }} 900w"
          sizes="(max-width: 800px) 100vw, 50vw"
          alt="{{ section.settings.image.alt | default: 'Gripfeet gifting' }}"
          width="900" height="1080"
          loading="lazy"
        >
      {%- else -%}
        <div class="gf-ph gf-ph--dark" style="aspect-ratio:5/6">
          <span class="gf-ph__label">[ Linen pouch · 3 folded pairs · hand-tied ]</span>
          <span class="gf-ph__corner">GF · GIFT 01</span>
        </div>
      {%- endif -%}
    </div>

    <div>
      <span class="gf-eyebrow gf-gifting__eyebrow">{{ section.settings.eyebrow }}</span>
      <h3>
        {{ section.settings.heading }}
        {%- if section.settings.heading_italic != blank -%}
          <em class="gf-italic">{{ section.settings.heading_italic }}</em>
        {%- endif -%}
        {{ section.settings.heading_after }}
      </h3>
      <p>{{ section.settings.desc }}</p>

      <ul class="gf-gifting__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <li {{ block.shopify_attributes }}>
              <span class="gf-gifting__list-n">{{ block.settings.code }}</span>
              {{ block.settings.text }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="gf-gifting__actions">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_link }}" class="gf-btn gf-btn--primary">
            {{ section.settings.cta_primary_label }}
            <svg class="gf-arrow-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_link }}" class="gf-btn gf-btn--ghost">
            {{ section.settings.cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Gifting",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image",               "label": "Gifting image (5:6 ratio)" },
    { "type": "text",         "id": "eyebrow",             "label": "Eyebrow",             "default": "08 — Gift & travel" },
    { "type": "text",         "id": "heading",             "label": "Heading",             "default": "The cleanest" },
    { "type": "text",         "id": "heading_italic",      "label": "Heading italic",      "default": "small gift" },
    { "type": "text",         "id": "heading_after",       "label": "Heading after italic","default": "we know." },
    { "type": "textarea",     "id": "desc",                "label": "Description",         "default": "Hand-folded into a Gripfeet linen pouch. A premium-feeling essential that's quietly useful — for the friend who travels, the partner who's just got into Pilates, the parent on hardwood floors." },
    { "type": "text",         "id": "cta_primary_label",   "label": "Primary CTA label",   "default": "Shop gifting" },
    { "type": "url",          "id": "cta_primary_link",    "label": "Primary CTA link" },
    { "type": "text",         "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Build a custom set" },
    { "type": "url",          "id": "cta_secondary_link",  "label": "Secondary CTA link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Gift Item",
      "settings": [
        { "type": "text", "id": "code", "label": "Code (A/B/C…)", "default": "A" },
        { "type": "text", "id": "text", "label": "Item text",      "default": "Hand-tied linen pouch" }
      ]
    }
  ],
  "presets": [{
    "name": "Gripfeet — Gifting",
    "blocks": [
      { "type": "item", "settings": { "code": "A", "text": "Hand-tied linen pouch" } },
      { "type": "item", "settings": { "code": "B", "text": "Personalised note card" } },
      { "type": "item", "settings": { "code": "C", "text": "Three-pair gift set" } },
      { "type": "item", "settings": { "code": "D", "text": "Free shipping worldwide" } }
    ]
  }]
}
{% endschema %}
