<section class="wrap section" id="gifting">
  <div class="gifting">
    <div class="visual">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="Gripfeet gifting" width="900" height="900" loading="lazy" style="width:100%;height:100%;object-fit:cover">
      {%- else -%}
        <div class="ph ph-dark">
          <span class="ph-label">Linen pouch · 3 folded pairs · hand-tied</span>
          <span class="ph-corner">GF · GIFT</span>
        </div>
      {%- endif -%}
    </div>
    <div>
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h3>{{ section.settings.heading }}</h3>
      <p>{{ section.settings.body }}</p>
      {%- assign gift_letters = "A,B,C,D,E,F,G,H" | split: "," -%}
      <ul>
        {%- for block in section.blocks -%}
          {%- if block.type == "item" -%}
            <li {{ block.shopify_attributes }}>
              <span class="n">{{ gift_letters[forloop.index0] }}</span>
              {{ block.settings.text }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="actions">
        <a href="{{ section.settings.cta_link }}" class="btn btn-light">
          {{ section.settings.cta_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Gifting",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image",     "label": "Gift image" },
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",    "default": "Gift & travel" },
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "The cleanest small gift we know." },
    { "type": "textarea", "id": "body",       "label": "Body",       "default": "Hand-folded into a Gripfeet linen pouch, a premium-feeling essential that's quietly useful." },
    { "type": "text",     "id": "cta_label",  "label": "CTA label",  "default": "Shop gifting" },
    { "type": "url",      "id": "cta_link",   "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Gift item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Hand-tied linen pouch" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Gripfeet — Gifting",
    "blocks": [
      { "type": "item", "settings": { "text": "Hand-tied linen pouch" } },
      { "type": "item", "settings": { "text": "Personalised note card" } },
      { "type": "item", "settings": { "text": "Three-pair gift set" } },
      { "type": "item", "settings": { "text": "Free shipping worldwide" } }
    ]
  }]
}
{% endschema %}