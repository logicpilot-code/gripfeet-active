{{ 'gripfeet-pdp-cat.css' | asset_url | stylesheet_tag }}

<section class="wrap section tight">
  <div class="section-head">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <div class="right"><span class="muted" style="font-size:13px" id="gf-qa-count">{{ section.blocks.size }} questions answered</span></div>
  </div>
  <div class="qa">
    <form class="qa-ask" id="gf-qa-form">
      <input id="gf-qa-input" placeholder="Have a question about fit, grip or care?">
      <button type="submit" class="btn btn-primary">Ask <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></button>
    </form>
    <div class="qa-list" id="gf-qa-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'qa' -%}
          <div class="qa-item{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
            <button type="button" class="qa-q">
              <span class="qa-mark">Q</span>
              <span class="qa-text">{{ block.settings.question }}</span>
              <span class="qa-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{% if forloop.first %}<line x1="5" y1="12" x2="19" y2="12"/>{% else %}<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>{% endif %}</svg></span>
            </button>
            <div class="qa-a-wrap"><div class="qa-a-inner">
              <span class="qa-mark a">A</span>
              <div><p>{{ block.settings.answer }}</p><span class="qa-meta">{{ block.settings.who | default: 'Gripfeet team' }} · {{ block.settings.votes | default: 0 }} found this helpful</span></div>
            </div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function () {
  var list = document.getElementById("gf-qa-list");
  if (!list) return;
  var plus = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
  var minus = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>';

  function bind(item) {
    var q = item.querySelector(".qa-q");
    if (!q || q.dataset.bound) return;
    q.dataset.bound = "1";
    q.addEventListener("click", function () {
      var wasOpen = item.classList.contains("open");
      list.querySelectorAll(".qa-item.open").forEach(function (it) { it.classList.remove("open"); var i = it.querySelector(".qa-ico"); if (i) i.innerHTML = plus; });
      if (!wasOpen) { item.classList.add("open"); var ico = item.querySelector(".qa-ico"); if (ico) ico.innerHTML = minus; }
    });
  }
  list.querySelectorAll(".qa-item").forEach(bind);

  var form = document.getElementById("gf-qa-form");
  var input = document.getElementById("gf-qa-input");
  var count = document.getElementById("gf-qa-count");
  if (form) form.addEventListener("submit", function (e) {
    e.preventDefault();
    var v = (input.value || "").trim();
    if (!v) return;
    var item = document.createElement("div");
    item.className = "qa-item open";
    item.innerHTML =
      '<button type="button" class="qa-q"><span class="qa-mark">Q</span><span class="qa-text"></span><span class="qa-ico">' + minus + '</span></button>' +
      '<div class="qa-a-wrap"><div class="qa-a-inner"><span class="qa-mark a">A</span><div><p>Thanks, our team usually answers within a day. We’ll email you when it’s live.</p><span class="qa-meta">Awaiting answer</span></div></div></div>';
    item.querySelector(".qa-text").textContent = v;
    list.querySelectorAll(".qa-item.open").forEach(function (it) { it.classList.remove("open"); var i = it.querySelector(".qa-ico"); if (i) i.innerHTML = plus; });
    item.classList.add("open");
    list.insertBefore(item, list.firstChild);
    bind(item);
    input.value = "";
    if (count) { var n = list.querySelectorAll(".qa-item").length; count.textContent = n + " questions answered"; }
  });
})();
</script>

{% schema %}
{
  "name": "GF PDP — Q&A",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions & answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ask us anything." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" },
        { "type": "text", "id": "who", "label": "Answered by", "default": "Gripfeet team" },
        { "type": "number", "id": "votes", "label": "Helpful votes", "default": 12 }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "GF PDP — Q&A",
    "blocks": [
      { "type": "qa", "settings": { "question": "Do these fit inside running shoes?", "answer": "Yes, the cuff and silicone footbed are low-profile enough for trainers, loafers and most everyday shoes.", "who": "Gripfeet team", "votes": 24 } },
      { "type": "qa", "settings": { "question": "Is the silicone safe on hardwood?", "answer": "Completely. The food-grade silicone grips without marking or scratching wood, marble or tile.", "who": "Gripfeet team", "votes": 18 } },
      { "type": "qa", "settings": { "question": "How do I wash them without ruining the grip?", "answer": "Cold machine wash inside out, air dry or tumble low. Never iron the sole. The grip lasts 80+ wears.", "who": "Gripfeet team", "votes": 12 } }
    ]
  }]
}
{% endschema %}
