<style>
  /* compact review cards + customer avatars (Brinda: add contact images + take less space) */
  #gf-reviews .reviews { gap: clamp(12px, 1.4vw, 18px); }
  #gf-reviews .review { min-height: 0; padding: clamp(18px, 1.8vw, 22px); }
  #gf-reviews .review .quote { font-size: 16px; line-height: 1.35; margin: 12px 0; }
  #gf-reviews .review .who { padding-top: 12px; align-items: center; gap: 11px; }
  #gf-reviews .review .who .av { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex-shrink: 0; box-shadow: inset 0 0 0 1px var(--hair-2); }
  #gf-reviews .review .who .av-ph { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; background: var(--cream-2); display: inline-flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--ink-2); }
  #gf-reviews .review .who .who-t { display: flex; flex-direction: column; line-height: 1.3; }
  #gf-reviews .review .who .loc { text-align: left; }
  #gf-reviews .section-head { margin-bottom: clamp(20px, 2.4vw, 30px); }
</style>
<section class="section band" id="gf-reviews">
  <div class="wrap">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
      </div>
      <div class="right">
        <div class="reviews-rating">
          <span class="big">{{ section.settings.rating }}</span>
          <div class="meta">
            <div class="stars">★★★★★</div>
            <div class="mono" style="font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)">{{ section.settings.review_count }}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="reviews">
      {%- for block in section.blocks -%}
        {%- if block.type == "review" -%}
          <div class="review" {{ block.shopify_attributes }}>
            <span class="stars">
              {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
            </span>
            <p class="quote">"{{ block.settings.quote }}"</p>
            <div class="who">
              {%- if block.settings.avatar != blank -%}
                <img class="av" src="{{ block.settings.avatar | image_url: width: 96 }}" alt="{{ block.settings.name }}" width="34" height="34" loading="lazy">
              {%- else -%}
                <span class="av-ph" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              {%- endif -%}
              <div class="who-t">
                <span class="name">{{ block.settings.name }}</span>
                <span class="loc">{{ block.settings.location }}</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow",      "label": "Eyebrow",       "default": "Worn-in opinions · Reviews" },
    { "type": "text", "id": "heading",      "label": "Heading",       "default": "Quiet wins, in their words." },
    { "type": "text", "id": "rating",       "label": "Avg rating",    "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count",  "default": "1,284 reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range",        "id": "stars",    "label": "Stars",    "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea",     "id": "quote",    "label": "Quote" },
        { "type": "text",         "id": "name",     "label": "Name" },
        { "type": "text",         "id": "location", "label": "Location" },
        { "type": "image_picker", "id": "avatar",   "label": "Customer photo" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Gripfeet — Reviews",
    "blocks": [
      { "type": "review", "settings": { "stars": 5, "quote": "Finally a grip sock that doesn't look like a hospital slipper. The silicone dots actually grip and the cotton is genuinely soft.", "name": "Priya M.", "location": "Mumbai" } },
      { "type": "review", "settings": { "stars": 5, "quote": "Wore them for Pilates, a 14-hour flight, and two days of meetings. Still look new. That's all you need to know.", "name": "Shreya A.", "location": "Bangalore" } },
      { "type": "review", "settings": { "stars": 5, "quote": "Bought the three-pack for my daughter's dance class. She refuses to take them off. We're back for the crew version.", "name": "Anita R.", "location": "Delhi" } }
    ]
  }]
}
{% endschema %}