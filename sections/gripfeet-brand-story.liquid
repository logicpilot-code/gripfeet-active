{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<section class="gf-wrap gf-section">
  <div class="gf-story">
    <div class="gf-story__visual">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          srcset="{{ section.settings.image | image_url: width: 450 }} 450w, {{ section.settings.image | image_url: width: 900 }} 900w"
          sizes="(max-width: 900px) 100vw, 45vw"
          alt="{{ section.settings.image.alt | default: 'Gripfeet brand story' }}"
          width="900" height="1125"
          loading="lazy"
        >
      {%- else -%}
        <div class="gf-ph" style="aspect-ratio:4/5">
          <span class="gf-ph__label">[ Editorial · close-up of knit &amp; silicone dots ]</span>
          <span class="gf-ph__corner">GF · 4:5</span>
        </div>
      {%- endif -%}
    </div>

    <div class="gf-story__text">
      <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="gf-h-section" style="margin-top:22px">
        {{ section.settings.heading }}
        {%- if section.settings.heading_italic != blank -%}
          <em class="gf-italic">{{ section.settings.heading_italic }}</em>
        {%- endif -%}
      </h2>

      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' -%}
          <p style="margin-top:{% if forloop.first %}28px{% else %}0{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.sig_name != blank -%}
        <div class="gf-story__sig">
          {{ section.settings.sig_name }}
          <small>{{ section.settings.sig_sub }}</small>
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link }}" class="gf-btn gf-btn--ghost" style="margin-top:32px">
          {{ section.settings.cta_label }}
          <svg class="gf-arrow-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Brand Story",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image",           "label": "Image (4:5 ratio)" },
    { "type": "text",         "id": "eyebrow",         "label": "Eyebrow",          "default": "04 — Our story · Made in India" },
    { "type": "text",         "id": "heading",         "label": "Heading",          "default": "A grip sock" },
    { "type": "text",         "id": "heading_italic",  "label": "Heading italic",   "default": "that finally feels like a sock." },
    { "type": "text",         "id": "sig_name",        "label": "Signature name",   "default": "The Gripfeet team" },
    { "type": "text",         "id": "sig_sub",         "label": "Signature subtitle","default": "Knit in India · Designed for everywhere" },
    { "type": "text",         "id": "cta_label",       "label": "CTA label" },
    { "type": "url",          "id": "cta_link",        "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Most grip socks fall into two camps — clinical and forgettable, or loud and over-sporty. We sat between them and built Gripfeet for the way people actually move: studios, hotel rooms, school runs, long flights, Sunday mornings." }
      ]
    }
  ],
  "presets": [{
    "name": "Gripfeet — Brand Story",
    "blocks": [
      { "type": "paragraph", "settings": { "text": "Most grip socks fall into two camps — clinical and forgettable, or loud and over-sporty. We sat between them and built Gripfeet for the way people actually move: studios, hotel rooms, school runs, long flights, Sunday mornings." } },
      { "type": "paragraph", "settings": { "text": "We knit ours in-house in India, with Supima cotton up top and a 100% silicone grip pattern on the sole — a manufacturing depth most lifestyle brands have to import. The result is the first Made-in-India grip sock you could genuinely wear out of the studio." } },
      { "type": "paragraph", "settings": { "text": "Calm, considered, comfortable. A wardrobe sock that happens to grip." } }
    ]
  }]
}
{% endschema %}
