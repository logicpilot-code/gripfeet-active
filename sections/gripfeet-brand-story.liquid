<section class="wrap section" id="story">
  <div class="story">
    <div class="visual">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="Gripfeet story" width="900" height="1125" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:var(--radius)">
      {%- else -%}
        <img src="{{ 'gf-story.jpg' | asset_url }}" alt="Cream cable-knit detail" width="1200" height="1750" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:center 40%;border-radius:var(--radius)">
      {%- endif -%}
    </div>
    <div class="text">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body_1 }}</p>
      <p>{{ section.settings.body_2 }}</p>
      <div class="sig">
        {{ section.settings.sig_name }}
        <small>{{ section.settings.sig_sub }}</small>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Brand Story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image",   "label": "Story image" },
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",  "default": "Our story · Made in India" },
    { "type": "text",     "id": "heading",  "label": "Heading",  "default": "A grip sock that finally feels like a sock." },
    { "type": "textarea", "id": "body_1",   "label": "Body 1",   "default": "Most grip socks fall into two camps: clinical and forgettable, or loud and over-sporty. We sat between them and built Gripfeet for the way people actually move: studios, hotel rooms, school runs, long flights, slow Sundays." },
    { "type": "textarea", "id": "body_2",   "label": "Body 2",   "default": "We knit ours in-house in India, Supima cotton up top, a 100% silicone grip pattern on the sole. A manufacturing depth most lifestyle brands have to import." },
    { "type": "text",     "id": "sig_name", "label": "Signature name", "default": "The Gripfeet team" },
    { "type": "text",     "id": "sig_sub",  "label": "Signature sub",  "default": "Knit in India · Designed for everywhere" }
  ],
  "presets": [{ "name": "Gripfeet — Brand Story" }]
}
{% endschema %}