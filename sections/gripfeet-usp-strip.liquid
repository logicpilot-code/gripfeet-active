<section class="section tight band">
  <div class="wrap">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="usps">
      {%- for block in section.blocks -%}
        {%- if block.type == "usp" -%}
          <div class="usp" {{ block.shopify_attributes }}>
            <h3 class="t">{{ block.settings.title }}</h3>
            <p class="d">{{ block.settings.desc }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet - Our Promise",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise · Six things that matter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quietly built, obsessively." }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "text",     "id": "title", "label": "Title", "default": "Stretch Supima Yarn" },
        { "type": "textarea", "id": "desc",  "label": "Description", "default": "Naturally breathable, beautifully soft, every wash." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Gripfeet - Our Promise",
    "blocks": [
      { "type": "usp", "settings": { "title": "Stretch Supima Yarn",       "desc": "Naturally breathable, beautifully soft, every wash." } },
      { "type": "usp", "settings": { "title": "100% Silicone Grip",         "desc": "Full-sole pattern, set in permanently. Never peels, never slips." } },
      { "type": "usp", "settings": { "title": "Perfect Fit, Always",        "desc": "Two size runs: ankle + crew in S-M / L-XL. Kids in 0-2Y / 3-5Y." } },
      { "type": "usp", "settings": { "title": "Easy Machine Care",          "desc": "Cold wash, air dry. The grip stays set after 50+ washes." } },
      { "type": "usp", "settings": { "title": "Made in India",              "desc": "Designed and knit in-house. Manufacturing depth most brands have to import." } },
      { "type": "usp", "settings": { "title": "Designed for Modern Life",   "desc": "Studio, hardwood, hotel rooms, sofa Sundays, for every step, every day." } }
    ]
  }]
}
{% endschema %}