{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<section class="section tight band">
  <div class="gf-wrap">
    <div class="gf-section-head">
      <div class="gf-section-head__left">
        <span class="gf-eyebrow"><span class="gf-dot"></span>{{ section.settings.eyebrow }}</span>
        <h2 class="gf-h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="usps">
      {%- for block in section.blocks -%}
        {%- if block.type == 'usp' -%}
          <div class="usp" {{ block.shopify_attributes }}>
            <span class="n">{{ block.settings.number }}</span>
            <span class="usp-ico">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19c4-4 8-6 14-14"/></svg>
                {%- when 'grip' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="17" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="17" cy="12" r="1"/><circle cx="7" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="17" cy="17" r="1"/></svg>
                {%- when 'fit' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                {%- when 'washer' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="5"/></svg>
                {%- when 'india' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3.5 0-6 2.5-6 6 0 4 6 12 6 12s6-8 6-12c0-3.5-2.5-6-6-6Z"/><circle cx="12" cy="9" r="2"/></svg>
                {%- when 'lifestyle' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>
              {%- endcase -%}
            </span>
            <h3 class="t">{{ block.settings.title }}</h3>
            <p class="d">{{ block.settings.desc }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Gripfeet — USP Strip (Active)","tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our promise · Six things that matter"},
    {"type":"text","id":"heading","label":"Heading","default":"Quietly built, obsessively."}
  ],
  "blocks":[{"type":"usp","name":"USP","settings":[
    {"type":"text","id":"number","label":"Number","default":"01"},
    {"type":"text","id":"title","label":"Title","default":"Stretch Supima Yarn"},
    {"type":"textarea","id":"desc","label":"Description","default":"Soft, breathable & durable."},
    {"type":"select","id":"icon","label":"Icon","options":[
      {"value":"leaf","label":"Leaf"},{"value":"grip","label":"Grip"},{"value":"fit","label":"Fit"},
      {"value":"washer","label":"Washer"},{"value":"india","label":"India"},{"value":"lifestyle","label":"Lifestyle"}
    ],"default":"leaf"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"Gripfeet — USP Strip (Active)","blocks":[
    {"type":"usp","settings":{"number":"01","title":"Stretch Supima Yarn","desc":"Soft, breathable & durable. Long-staple cotton that softens with every wash.","icon":"leaf"}},
    {"type":"usp","settings":{"number":"02","title":"Superior Antislip Grip","desc":"100% silicone, full-sole pattern. Extra stability on any surface.","icon":"grip"}},
    {"type":"usp","settings":{"number":"03","title":"Perfect Fit","desc":"Available in 2–3 sizes for a better fit. Reinforced heel, ribbed cuff.","icon":"fit"}},
    {"type":"usp","settings":{"number":"04","title":"Easy Care","desc":"Machine washable & long-lasting. Knit and finished in India.","icon":"washer"}},
    {"type":"usp","settings":{"number":"05","title":"Made in India","desc":"Designed and knit in-house with manufacturing depth most lifestyle brands import.","icon":"india"}},
    {"type":"usp","settings":{"number":"06","title":"Designed for Modern Life","desc":"A wardrobe sock that happens to grip. Studio, hardwood, hotel rooms, sofa Sundays.","icon":"lifestyle"}}
  ]}]
}
{% endschema %}
