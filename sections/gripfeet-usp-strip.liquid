{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<section class="gf-section gf-section--tight gf-section--band">
  <div class="gf-wrap">
    <div class="gf-section-head">
      <div class="gf-section-head__left">
        <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="gf-h-section">
          {{ section.settings.heading }}
          {%- if section.settings.heading_italic != blank -%}
            <em class="gf-italic">{{ section.settings.heading_italic }}</em>
          {%- endif -%}
        </h2>
      </div>
    </div>

    <div class="gf-usps">
      {%- for block in section.blocks -%}
        <div class="gf-usp" {{ block.shopify_attributes }}>
          <span class="gf-usp__n">{{ block.settings.number }}</span>
          <h3 class="gf-usp__t">{{ block.settings.title }}</h3>
          <p class="gf-usp__d">{{ block.settings.desc }}</p>
          <span class="gf-usp__ico" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19c4-4 8-6 14-14"/></svg>
              {%- when 'grip' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="17" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="17" cy="12" r="1"/><circle cx="7" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="17" cy="17" r="1"/></svg>
              {%- when 'fit' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
              {%- when 'washer' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="5"/><circle cx="8" cy="6" r=".5" fill="currentColor"/></svg>
              {%- when 'india' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3.5 0-6 2.5-6 6 0 4 6 12 6 12s6-8 6-12c0-3.5-2.5-6-6-6Z"/><circle cx="12" cy="9" r="2"/></svg>
              {%- when 'lifestyle' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg>
              {%- else -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
            {%- endcase -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GF Why Gripfeet",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow",        "label": "Eyebrow",        "default": "05 — Our promise · Six things that matter" },
    { "type": "text", "id": "heading",        "label": "Heading",        "default": "Quietly built," },
    { "type": "text", "id": "heading_italic", "label": "Heading italic", "default": "obsessively." }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "text", "id": "number", "label": "Number (e.g. 01)", "default": "01" },
        { "type": "text", "id": "title",  "label": "Title",            "default": "Stretch Supima Yarn" },
        { "type": "text", "id": "desc",   "label": "Description",      "default": "Soft, breathable & durable. Long-staple cotton that softens with every wash." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",      "label": "Leaf" },
            { "value": "grip",      "label": "Grip dots" },
            { "value": "fit",       "label": "Fit" },
            { "value": "washer",    "label": "Washer" },
            { "value": "india",     "label": "India" },
            { "value": "lifestyle", "label": "Lifestyle" },
            { "value": "check",     "label": "Check" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "GF Why Gripfeet",
    "blocks": [
      { "type": "usp", "settings": { "number": "01", "title": "Stretch Supima Yarn",          "desc": "Soft, breathable & durable. Long-staple cotton that softens with every wash.",                                                          "icon": "leaf" } },
      { "type": "usp", "settings": { "number": "02", "title": "Superior Antislip Grip",       "desc": "100% silicone, full-sole pattern. Extra stability on any surface — studio, hardwood, marble, tile.",                                   "icon": "grip" } },
      { "type": "usp", "settings": { "number": "03", "title": "Perfect Fit",                  "desc": "Available in 2–3 sizes for a better fit. Reinforced heel, ribbed cuff, no slip-down.",                                                "icon": "fit" } },
      { "type": "usp", "settings": { "number": "04", "title": "Easy Care",                    "desc": "Machine washable & long-lasting. Knit and finished in India for the long run.",                                                        "icon": "washer" } },
      { "type": "usp", "settings": { "number": "05", "title": "Made in India",                "desc": "Designed and knit in-house with the manufacturing depth most lifestyle brands import. Closer to the loom, fewer compromises.",          "icon": "india" } },
      { "type": "usp", "settings": { "number": "06", "title": "Designed for Modern Lifestyles","desc": "A wardrobe sock that happens to grip. Studio, hardwood, hotel rooms, sofa Sundays — Gripfeet is for every step, every day.",           "icon": "lifestyle" } }
    ]
  }]
}
{% endschema %}
