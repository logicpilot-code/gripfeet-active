{{ 'gripfeet-pdp.css' | asset_url | stylesheet_tag }}
{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}

<div class="gf-wrap pdp-breadcrumb">
  <a href="/">Home</a>
  <span class="sep">/</span>
  <a href="{{ product.collections.first.url | default: '/collections/all' }}">{{ product.collections.first.title | default: 'Shop' }}</a>
  <span class="sep">/</span>
  <span class="here">{{ product.title }}</span>
</div>

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_image = product.featured_image -%}

<section class="gf-wrap pdp" id="pdp-hero">

  <div class="pdp-gallery">
    <div class="pdp-thumbs">
      {%- for image in product.images limit: 5 -%}
        <button class="pdp-thumb{% if forloop.first %} active{% endif %}" onclick="document.getElementById('pdp-main-img').src='{{ image | image_url: width: 1200 }}';document.querySelectorAll('.pdp-thumb').forEach(el=>el.classList.remove('active'));this.classList.add('active')" aria-label="View image {{ forloop.index }}">
          <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title }}" width="84" height="84" loading="lazy">
        </button>
      {%- else -%}
        {%- for i in (1..5) -%}
          <button class="pdp-thumb{% if forloop.first %} active{% endif %}" aria-label="View {{ i }}">
            <div class="gf-ph" style="width:100%;height:100%;min-height:80px"><span class="gf-ph__corner">{{ i }}</span></div>
          </button>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <div class="pdp-main">
      {%- if product_image != blank -%}
        <img id="pdp-main-img" src="{{ product_image | image_url: width: 1200 }}" alt="{{ product_image.alt | default: product.title }}" width="600" height="750" loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- else -%}
        <div class="gf-ph" style="width:100%;height:100%;min-height:480px">
          <span class="gf-ph__label">{{ product.title }} · product image</span>
          <span class="gf-ph__corner">{{ product.handle }}</span>
        </div>
      {%- endif -%}
      <span class="pdp-save">Launch price</span>
    </div>
  </div>

  <div class="pdp-info">
    <span class="pdp-range">{{ product.type | default: product.collections.first.title }}</span>
    <h1 class="pdp-name">{{ product.title }}</h1>

    <a href="#pdp-reviews" class="pdp-stars">
      <span style="color:var(--gf-ink)">★★★★★</span>
      <span>4.8 · 1,200+ reviews</span>
    </a>

    <div class="pdp-price" id="pdp-price-display">
      <span class="now">{{ current_variant.price | money }}</span>
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="was">{{ current_variant.compare_at_price | money }}</span>
        <span class="tag">−{{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}% off</span>
      {%- endif -%}
    </div>

    <p class="pdp-blurb">{{ product.description | strip_html | truncatewords: 40 }}</p>

    {%- unless product.has_only_default_variant -%}
      <div class="pdp-opt">
        {%- for option in product.options_with_values -%}
          <div class="olbl"><span>{{ option.name }}</span></div>
          <div class="pdp-pills">
            {%- for value in option.values -%}
              <label class="pdp-pill {% if option.selected_value == value %}on{% endif %}">
                <input type="radio" name="{{ option.name | handleize }}" value="{{ value }}" style="display:none" {% if option.selected_value == value %}checked{% endif %}>
                {{ value }}
              </label>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div class="pdp-opt">
      <div class="olbl"><span>Pack size</span></div>
      <div class="pack-grid">
        <button class="pack-card" data-pack="single">
          <span class="pack-name">Single</span>
          <span class="pack-sub">1 pair</span>
          <span class="pack-price">{{ current_variant.price | minus: 150 | money }}</span>
        </button>
        <button class="pack-card on">
          <span class="pack-badge">Save 17%</span>
          <span class="pack-name">Pack of 3</span>
          <span class="pack-sub">3 pairs</span>
          <span class="pack-price">{{ current_variant.price | money }}</span>
        </button>
        <button class="pack-card">
          <span class="pack-badge">Best value</span>
          <span class="pack-name">Pack of 6</span>
          <span class="pack-sub">6 pairs</span>
          <span class="pack-price">{{ current_variant.price | times: 2 | minus: 200 | money }}</span>
        </button>
      </div>
    </div>

    {%- if product.options contains 'Size' -%}
      <div class="pdp-opt">
        <div class="olbl"><span>Size</span><a class="size-guide" href="/pages/sizing-guide">Sizing guide</a></div>
        <div class="pdp-sizes">
          {%- assign size_option = product.options_with_values | where: "name", "Size" | first -%}
          {%- for size in size_option.values -%}
            <button class="pdp-size {% if size_option.selected_value == size %}on{% endif %}">
              <b>{{ size }}</b>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="pdp-buy" style="margin-top:28px">
      {%- form 'product', product, id: 'gf-pdp-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div class="pdp-qty">
          <button type="button" onclick="var v=document.getElementById('pdp-qty-val');v.textContent=Math.max(1,parseInt(v.textContent)-1)" aria-label="Decrease">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
          </button>
          <span class="val" id="pdp-qty-val">1</span>
          <button type="button" onclick="var v=document.getElementById('pdp-qty-val');v.textContent=parseInt(v.textContent)+1" aria-label="Increase">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          </button>
        </div>
        <button type="submit" name="add" class="gf-btn gf-btn--primary pdp-add">
          Add to bag — {{ current_variant.price | money }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </button>
      {%- endform -%}
    </div>

    <div class="pdp-trust">
      <div class="pdp-trust-item"><span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19c4-4 8-6 14-14"/></svg></span><div><strong>Stretch Supima Yarn</strong><small>Soft, breathable & durable.</small></div></div>
      <div class="pdp-trust-item"><span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="17" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="17" cy="12" r="1"/><circle cx="7" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="17" cy="17" r="1"/></svg></span><div><strong>100% Silicone Grip</strong><small>Full-sole antislip pattern.</small></div></div>
      <div class="pdp-trust-item"><span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span><div><strong>Perfect Fit</strong><small>2–3 sizes for a better fit.</small></div></div>
      <div class="pdp-trust-item"><span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg></span><div><strong>Ships Globally</strong><small>4–7 days · COD available.</small></div></div>
    </div>

    <div class="pdp-accordion">
      <div class="pacc open">
        <button class="pacc-head" onclick="this.closest('.pacc').classList.toggle('open')">Materials & Make<span class="pacc-ico">+</span></button>
        <div class="pacc-body"><div class="pacc-inner"><p>72% Stretch Supima cotton · 24% recycled nylon · 4% elastane. 100% food-grade silicone grip on the full sole. Reinforced heel & toe. Ribbed cuff for a secure, no-slip-down fit.</p></div></div>
      </div>
      <div class="pacc">
        <button class="pacc-head" onclick="this.closest('.pacc').classList.toggle('open')">Sizing & Fit<span class="pacc-ico">+</span></button>
        <div class="pacc-body"><div class="pacc-inner"><p>Available in 2–3 sizes. UK 3–6 (S), 6–9 (M), 9–12 (L). Wears slightly snug out of the wash — softens after first wear.</p></div></div>
      </div>
      <div class="pacc">
        <button class="pacc-head" onclick="this.closest('.pacc').classList.toggle('open')">Care & Washing<span class="pacc-ico">+</span></button>
        <div class="pacc-body"><div class="pacc-inner"><p>Machine washable, cold cycle, inside out. Tumble dry low or air dry. Do not iron the silicone sole. The pair will last 80+ wears with normal care.</p></div></div>
      </div>
      <div class="pacc">
        <button class="pacc-head" onclick="this.closest('.pacc').classList.toggle('open')">Shipping & Returns<span class="pacc-ico">+</span></button>
        <div class="pacc-body"><div class="pacc-inner"><p>Ships globally, 4–7 day delivery. Free shipping over ₹999. COD available across India. All sales are final, with a quality guarantee — if anything's wrong with the make, we replace it.</p></div></div>
      </div>
    </div>
  </div>

</section>

{%- if section.settings.show_related -%}
  <section class="gf-wrap section pdp-related" id="pdp-reviews">
    <div class="gf-section-head">
      <div class="gf-section-head__left">
        <span class="gf-eyebrow"><span class="gf-dot"></span>Wear it with</span>
        <h2 class="gf-h-section" style="margin-top:14px">The rest of the range.</h2>
      </div>
      <div class="gf-section-head__right"><a href="/collections/all" class="gf-btn-link">Shop all</a></div>
    </div>
    <div class="pdp-related-grid">
      {%- assign related = collections[product.collections.first.handle].products | where: 'available', true -%}
      {%- for rp in related limit: 4 -%}
        {%- unless rp.id == product.id -%}
          <a class="gf-pcard" href="{{ rp.url }}">
            <div class="gf-pcard__img">
              {%- if rp.featured_image -%}
                <img src="{{ rp.featured_image | image_url: width: 600 }}" alt="{{ rp.title }}" width="300" height="300" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
              {%- else -%}
                <div class="gf-ph" style="width:100%;height:100%;min-height:200px"><span class="gf-ph__label">{{ rp.title }}</span></div>
              {%- endif -%}
            </div>
            <div class="gf-pcard__range">{{ rp.type }}</div>
            <div class="gf-pcard__name">{{ rp.title }}</div>
            <div class="gf-pcard__price">{{ rp.price | money }}</div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<div class="pdp-buybar" id="pdp-buybar">
  <div class="bb-meta">
    <div class="bb-name">{{ product.title }}</div>
    <div class="bb-sub">{{ current_variant.price | money }} · Pack of 3</div>
  </div>
  <button class="gf-btn gf-btn--primary" onclick="document.getElementById('gf-pdp-form').querySelector('[name=add]').click()">Add to bag</button>
</div>

<script>
  window.addEventListener('scroll', function(){
    var bar = document.getElementById('pdp-buybar');
    if(bar) bar.classList.toggle('visible', window.scrollY > 600);
  }, {passive:true});
  document.querySelectorAll('.pack-card').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.pack-card').forEach(function(b){b.classList.remove('on')});
      this.classList.add('on');
    });
  });
  document.querySelectorAll('.pacc-head').forEach(function(btn){
    var ico = btn.querySelector('.pacc-ico');
    if(ico) btn.addEventListener('click', function(){
      var open = btn.closest('.pacc').classList.contains('open');
      ico.textContent = open ? '+' : '−';
    });
  });
</script>

{% schema %}
{
  "name":"Gripfeet — PDP (Active)","tag":"section",
  "settings":[
    {"type":"checkbox","id":"show_related","label":"Show related products","default":true}
  ],
  "presets":[{"name":"Gripfeet — PDP (Active)"}]
}
{% endschema %}
