{{ 'gripfeet-pdp.css' | asset_url | stylesheet_tag }}
{{ 'gripfeet-pdp-cat.css' | asset_url | stylesheet_tag }}

{%- comment -%} Derive the range (ankle/crew/loafer/kids) from type/tags → accent + size table {%- endcomment -%}
{%- liquid
  assign hay = product.type | append: ' ' | append: product.title | downcase
  assign tagstr = product.tags | join: ' ' | downcase
  assign hay = hay | append: ' ' | append: tagstr
  if hay contains 'crew' or hay contains 'active hold'
    assign range_id = 'crew'
    assign accent_class = 'acc-lime crew-dark'
  elsif hay contains 'loafer' or hay contains 'invisible'
    assign range_id = 'loafer'
    assign accent_class = 'acc-clay'
  elsif hay contains 'kid' or hay contains 'lil steps'
    assign range_id = 'kids'
    assign accent_class = 'acc-coral'
  else
    assign range_id = 'ankle'
    assign accent_class = 'acc-sage'
  endif
  assign stock_left = product.id | modulo: 8 | plus: 5
  assign first_variant = product.selected_or_first_available_variant
-%}

<script>document.documentElement.className += ' {{ accent_class }}';</script>

<div class="wrap pdp-breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span class="sep">/</span>
  {%- if product.collections.first -%}
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    <span class="sep">/</span>
  {%- endif -%}
  <span class="here">{{ product.title }}</span>
</div>

<section class="wrap pdp">

  <!-- Gallery -->
  <div class="pdp-gallery" id="pdp-gallery">
    <div class="pdp-thumbs" id="pdp-thumbs">
      {%- for media in product.media limit: 5 -%}
        <button type="button" class="pdp-thumb{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}" data-full="{{ media | image_url: width: 1200 }}" aria-label="View {{ forloop.index }}">
          <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | default: product.title | escape }}" width="160" height="160" loading="lazy" style="width:100%;height:100%;object-fit:cover">
        </button>
      {%- else -%}
        {%- for i in (1..5) -%}
          <button type="button" class="pdp-thumb{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}" aria-label="View {{ forloop.index }}">
            <div class="ph" style="width:100%;height:100%"><span class="ph-corner">{{ forloop.index }}</span></div>
          </button>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div class="pdp-main" id="pdp-main-img">
      {%- if product.featured_image != blank -%}
        <img id="pdp-main-photo" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="1200" height="1500" loading="eager" style="width:100%;height:100%;object-fit:cover">
      {%- else -%}
        <div class="ph ph-photo" style="width:100%;height:100%">
          <span class="ph-label">{{ product.title }} · lifestyle shot</span>
          <span class="ph-corner">GF</span>
        </div>
      {%- endif -%}
      {%- if product.compare_at_price_max > product.price_min -%}
        {%- assign off = product.compare_at_price_max | minus: product.price_min | times: 100 | divided_by: product.compare_at_price_max -%}
        <span class="pdp-save" id="pdp-save">Launch · save {{ off }}%</span>
      {%- endif -%}
      <button type="button" class="pdp-zoom" id="pdp-zoom-btn" aria-label="Zoom">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button type="button" class="pdp-wish" aria-label="Wishlist">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10Z"/></svg>
      </button>
    </div>
  </div>

  <!-- Info -->
  <div class="pdp-info">
    <span class="pdp-range">{{ product.type | default: 'Gripfeet' }}</span>
    <h1 class="pdp-name">{{ product.title }}</h1>

    <a href="#pdp-reviews" class="pdp-stars">
      <span class="stars-svg">★★★★★</span>
      <span>{{ product.metafields.reviews.rating.value | default: '4.9' }} · {{ product.metafields.reviews.rating_count.value | default: '284' }} reviews</span>
    </a>

    <div class="pdp-price">
      <span class="now" id="pdp-price">₹{{ first_variant.price | money_without_currency }}</span>
      {%- if product.compare_at_price_max > product.price_min -%}
        <span class="was" id="pdp-was">₹{{ first_variant.compare_at_price | money_without_currency }}</span>
        <span class="tag" id="pdp-tag">−{{ off }}% off</span>
      {%- endif -%}
    </div>

    {%- if product.description != blank -%}
      <p class="pdp-blurb">{{ product.description | strip_html | truncate: 280 }}</p>
    {%- endif -%}

    <!-- Stock urgency -->
    <div class="pdp-stock">
      <span class="dotpulse"></span>
      Selling fast: <strong>{{ stock_left }} packs</strong> left at launch price
    </div>

    {%- form 'product', product, id: 'gf-pdp-form' -%}

      {%- comment -%} Generic, variant-wired option selectors - covers every product option {%- endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- assign oname = option.name | downcase -%}
        {%- assign oidx = forloop.index0 -%}
        {%- assign current_val = first_variant.options[oidx] -%}

        {%- if oname contains 'pack' -%}
          <div class="pdp-opt">
            <div class="olbl"><span>{{ option.name }}</span></div>
            <div class="pack-grid">
              {%- for val in option.values -%}
                <button type="button" class="pack-card gf-optbtn{% if val == current_val %} on{% endif %}" data-opt="{{ oidx }}" data-value="{{ val | escape }}">
                  {%- if val contains '6' %}<span class="pack-badge">Best value</span>{% elsif val contains '3' %}<span class="pack-badge">Save 17%</span>{% endif -%}
                  <span class="pack-name">{{ val }}</span>
                  <span class="pack-sub">
                    {%- if val contains '6' -%}6 pairs{% elsif val contains '3' -%}3 pairs{% elsif val contains '2' -%}2 pairs{% else -%}1 pair{% endif -%}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>

        {%- elsif oname contains 'colour' or oname contains 'color' or oname contains 'style' -%}
          <div class="pdp-opt">
            <div class="olbl"><span>{{ option.name }}</span></div>
            <div class="pdp-swatches">
              {%- for val in option.values -%}
                <button type="button" class="pdp-sw gf-optbtn{% if val == current_val %} on{% endif %}" data-opt="{{ oidx }}" data-value="{{ val | escape }}">
                  <span class="dot" style="background:{% if val.swatch.color %}{{ val.swatch.color }}{% else %}var(--accent-soft){% endif %}"></span>
                  <span class="swl">{{ val }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>

        {%- elsif oname contains 'size' -%}
          <div class="pdp-opt">
            <div class="olbl"><span>{{ option.name }}</span><button type="button" class="size-guide" id="pdp-sizeguide-open">Size &amp; fit finder</button></div>
            <div class="pdp-sizes">
              {%- for val in option.values -%}
                <button type="button" class="pdp-size gf-optbtn{% if val == current_val %} on{% endif %}" data-opt="{{ oidx }}" data-value="{{ val | escape }}">
                  <b>{{ val }}</b>
                </button>
              {%- endfor -%}
            </div>
          </div>

        {%- else -%}
          <div class="pdp-opt">
            <div class="olbl"><span>{{ option.name }}</span></div>
            <div class="pdp-sizes">
              {%- for val in option.values -%}
                <button type="button" class="pdp-size gf-optbtn{% if val == current_val %} on{% endif %}" data-opt="{{ oidx }}" data-value="{{ val | escape }}"><b>{{ val }}</b></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Hidden variant selector (driven by the option buttons above) -->
      <select name="id" id="gf-variant-select" style="display:none">
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}"
            {%- if variant == first_variant %} selected{% endif -%}
            {% unless variant.available %} disabled{% endunless %}>
            {{ variant.title }}
          </option>
        {%- endfor -%}
      </select>

      <!-- Buy row -->
      <div class="pdp-buy">
        <div class="pdp-qty">
          <button type="button" id="pdp-qty-dec" aria-label="Decrease">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <span class="val" id="pdp-qty-val">1</span>
          <input type="number" name="quantity" id="pdp-qty-input" value="1" min="1" style="display:none">
          <button type="button" id="pdp-qty-inc" aria-label="Increase">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
        <button type="submit" class="btn btn-primary pdp-add" id="pdp-add-btn">
          <span id="pdp-add-label">Add to bag · ₹{{ first_variant.price | money_without_currency }}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </button>
      </div>

    {%- endform -%}

    <!-- Secondary actions -->
    <div class="pdp-secondary">
      <button type="button"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10Z"/></svg> Wishlist</button>
      <span class="div"></span>
      <button type="button" id="pdp-sizeguide-open-2"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg> Size &amp; fit</button>
    </div>

    <!-- Pincode delivery estimate -->
    <div class="pdp-pincode">
      <span class="pin-ico"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg></span>
      <div class="pin-field">
        <input type="text" inputmode="numeric" id="pdp-pin" placeholder="Delivery pincode" maxlength="6">
        <button type="button" id="pdp-pin-check">Check</button>
      </div>
      <div class="pin-out" id="pdp-pin-out" style="display:none"></div>
    </div>

    <!-- Trust grid -->
    <div class="pdp-trust">
      <div class="pdp-trust-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        <div><strong>Quality guaranteed</strong><small>Each pair checked before dispatch.</small></div>
      </div>
      <div class="pdp-trust-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="m16 8 5 3v5h-5"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
        <div><strong>Ships in 1-2 days</strong><small>4-7 day global delivery. COD available.</small></div>
      </div>
      <div class="pdp-trust-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/></svg></span>
        <div><strong>Supima cotton</strong><small>Naturally breathable, soft every wash.</small></div>
      </div>
      <div class="pdp-trust-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg></span>
        <div><strong>Made in India</strong><small>Knit in-house. Depth most brands import.</small></div>
      </div>
    </div>

    <!-- Accordion -->
    <div class="pdp-accordion" id="pdp-accordion">
      <div class="pacc open" data-id="materials">
        <button type="button" class="pacc-head">Materials &amp; Make<span class="pacc-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg></span></button>
        <div class="pacc-body"><div class="pacc-inner"><ul><li>72% Stretch Supima cotton · 24% recycled nylon · 4% elastane</li><li>100% silicone grip pattern on the full sole, not painted-on rubber</li><li>Reinforced heel &amp; toe · ribbed no-slip cuff</li></ul></div></div>
      </div>
      <div class="pacc" data-id="care">
        <button type="button" class="pacc-head">Care &amp; Washing<span class="pacc-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span></button>
        <div class="pacc-body"><div class="pacc-inner"><ul><li>Machine wash cold, gentle cycle, inside out</li><li>Air dry or tumble dry low, never iron the sole</li><li>Grip stays set for 50+ washes</li></ul></div></div>
      </div>
      <div class="pacc" data-id="shipping">
        <button type="button" class="pacc-head">Shipping &amp; Returns<span class="pacc-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span></button>
        <div class="pacc-body"><div class="pacc-inner"><ul><li>Ships in 1-2 business days from India</li><li>4-7 day delivery worldwide · COD available</li><li>Free shipping over ₹999 · quality guarantee on every pair</li></ul></div></div>
      </div>
    </div>
  </div><!-- /pdp-info -->

</section><!-- /pdp -->

<!-- Size guide modal -->
<div class="pdp-modal-bg" id="pdp-sizeguide-bg"></div>
<div class="pdp-modal" id="pdp-sizeguide" role="dialog" aria-label="Size guide" aria-hidden="true">
  <div class="pmd-head">
    <div>
      <span class="eyebrow"><span class="dot"></span>Sizing &amp; fit</span>
      <h3 style="margin-top:12px">Find your size.</h3>
    </div>
    <button type="button" class="icon-btn" id="pdp-sizeguide-close" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <table class="size-table">
    <thead><tr><th>Size</th><th>{% if range_id == 'kids' %}Age{% else %}UK shoe{% endif %}</th><th>EU</th><th>Foot length</th></tr></thead>
    <tbody>
      {%- if range_id == 'kids' -%}
        <tr><td class="sz">XS</td><td>0-1 yr</td><td>EU 16-19</td><td>8-11 cm</td></tr>
        <tr><td class="sz">S</td><td>1-3 yr</td><td>EU 20-24</td><td>11-14 cm</td></tr>
        <tr><td class="sz">M</td><td>3-5 yr</td><td>EU 25-29</td><td>14-17 cm</td></tr>
      {%- elsif range_id == 'crew' -%}
        <tr><td class="sz">S</td><td>UK 4-7</td><td>EU 37-40</td><td>24-26 cm</td></tr>
        <tr><td class="sz">M</td><td>UK 7-10</td><td>EU 40-44</td><td>26-28 cm</td></tr>
        <tr><td class="sz">L</td><td>UK 10-13</td><td>EU 44-47</td><td>28-31 cm</td></tr>
      {%- else -%}
        <tr><td class="sz">S</td><td>UK 3-6</td><td>EU 36-39</td><td>23-25 cm</td></tr>
        <tr><td class="sz">M</td><td>UK 6-9</td><td>EU 39-42</td><td>25-27 cm</td></tr>
        <tr><td class="sz">L</td><td>UK 9-12</td><td>EU 42-46</td><td>27-30 cm</td></tr>
      {%- endif -%}
    </tbody>
  </table>
  <p class="pmd-note">Gripfeet knit runs true to size and wears slightly snug out of the wash. The Supima softens after first wear. Between sizes? Size down for studio grip, up for all-day wear.</p>
  <div class="pmd-measure">
    <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
    <p><strong>Measure at home:</strong> stand on paper, mark heel to longest toe, measure in cm. Match the foot-length column above.</p>
  </div>
</div>

<!-- Zoom lightbox -->
<div class="pdp-zoombg" id="pdp-zoombg" style="display:none">
  <button type="button" class="pdp-zoomclose" id="pdp-zoom-close" aria-label="Close"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  {%- if product.featured_image != blank -%}
    <img id="pdp-zoom-img" src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.title | escape }}" width="720" height="900" style="width:min(80vw,720px);aspect-ratio:4/5;object-fit:cover;border-radius:var(--radius)">
  {%- endif -%}
</div>

{%- comment -%} Related products / cross-sell handled by the GF PDP - Cross-sell section in product.json {%- endcomment -%}

<!-- Sticky buy bar -->
<div class="pdp-buybar" id="pdp-buybar">
  <div class="bb-meta">
    <div class="bb-name">{{ product.title }}</div>
    <div class="bb-sub" id="pdp-bb-sub">{{ product.type }}</div>
  </div>
  <button type="button" class="btn btn-primary" id="pdp-bb-add">
    <span id="pdp-bb-label">Add to bag · ₹{{ first_variant.price | money_without_currency }}</span>
  </button>
</div>

<script>
(function () {
  var VARIANTS = {{ product.variants | json }};
  var OPT_COUNT = {{ product.options.size }};
  var first = {{ first_variant | json }};

  var selected = (first.options || []).slice();
  var currentVariant = first;

  // record this product for "recently viewed" (lightweight, no fetch)
  try {
    var RV = "gf_recently_viewed";
    var cur = { handle: {{ product.handle | json }}, title: {{ product.title | json }}, type: {{ product.type | json }}, price: {{ product.price | money_without_currency | json }}, url: {{ product.url | json }}, img: {{ product.featured_image | image_url: width: 600 | json }} };
    var prevRV = JSON.parse(localStorage.getItem(RV) || "[]").filter(function (x) { return x && x.handle !== cur.handle; });
    localStorage.setItem(RV, JSON.stringify([cur].concat(prevRV).slice(0, 8)));
  } catch (e) {}

  var priceEl = document.getElementById("pdp-price");
  var wasEl   = document.getElementById("pdp-was");
  var tagEl   = document.getElementById("pdp-tag");
  var saveEl  = document.getElementById("pdp-save");
  var addLbl  = document.getElementById("pdp-add-label");
  var addBtn  = document.getElementById("pdp-add-btn");
  var bbLabel = document.getElementById("pdp-bb-label");
  var bbSub   = document.getElementById("pdp-bb-sub");
  var sel     = document.getElementById("gf-variant-select");

  var qty = 1;
  var qVal = document.getElementById("pdp-qty-val");
  var qInp = document.getElementById("pdp-qty-input");

  function rupees(cents) { return "₹" + Math.round(cents / 100).toLocaleString("en-IN"); }

  function findVariant() {
    return VARIANTS.find(function (v) {
      for (var i = 0; i < OPT_COUNT; i++) { if (v.options[i] !== selected[i]) return false; }
      return true;
    });
  }

  function render() {
    var v = currentVariant;
    if (!v) {
      if (addLbl) addLbl.textContent = "Unavailable";
      if (addBtn) addBtn.setAttribute("disabled", "disabled");
      return;
    }
    if (addBtn) addBtn.removeAttribute("disabled");
    if (sel) sel.value = v.id;

    var lineTotal = v.price * qty;
    if (priceEl) priceEl.textContent = rupees(v.price);
    if (addLbl)  addLbl.textContent  = (v.available ? "Add to bag · " : "Sold out · ") + rupees(lineTotal);
    if (bbLabel) bbLabel.textContent = "Add to bag · " + rupees(lineTotal);
    if (bbSub)   bbSub.textContent   = rupees(v.price) + " · " + v.title;

    if (v.compare_at_price && v.compare_at_price > v.price) {
      var off = Math.round((1 - v.price / v.compare_at_price) * 100);
      if (wasEl)  { wasEl.style.display = ""; wasEl.textContent = rupees(v.compare_at_price); }
      if (tagEl)  { tagEl.style.display = ""; tagEl.textContent = "−" + off + "% off"; }
      if (saveEl) saveEl.textContent = "Launch · save " + off + "%";
    } else {
      if (wasEl) wasEl.style.display = "none";
      if (tagEl) tagEl.style.display = "none";
    }

    if (addBtn) {
      if (!v.available) { addBtn.setAttribute("disabled", "disabled"); }
      else { addBtn.removeAttribute("disabled"); }
    }
  }

  // option buttons
  document.querySelectorAll(".gf-optbtn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var idx = parseInt(btn.dataset.opt, 10);
      var val = btn.dataset.value;
      // toggle .on within the same option group
      btn.parentNode.querySelectorAll(".gf-optbtn").forEach(function (b) { b.classList.remove("on"); });
      btn.classList.add("on");
      selected[idx] = val;
      var v = findVariant();
      if (v) currentVariant = v;
      render();
    });
  });

  // qty
  function setQty(n) { qty = Math.max(1, n); if (qVal) qVal.textContent = qty; if (qInp) qInp.value = qty; render(); }
  var dec = document.getElementById("pdp-qty-dec");
  var inc = document.getElementById("pdp-qty-inc");
  if (dec) dec.addEventListener("click", function () { setQty(qty - 1); });
  if (inc) inc.addEventListener("click", function () { setQty(qty + 1); });

  // sticky bar add -> submit the real form
  var bbAdd = document.getElementById("pdp-bb-add");
  if (bbAdd && addBtn) bbAdd.addEventListener("click", function () { addBtn.click(); });

  // gallery thumbs
  var mainPhoto = document.getElementById("pdp-main-photo");
  document.querySelectorAll(".pdp-thumb").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".pdp-thumb").forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");
      if (mainPhoto && btn.dataset.full) mainPhoto.src = btn.dataset.full;
    });
  });

  // accordion
  document.querySelectorAll(".pacc-head").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var pacc = btn.closest(".pacc");
      pacc.classList.toggle("open");
      var ico = btn.querySelector(".pacc-ico");
      if (ico) {
        ico.innerHTML = pacc.classList.contains("open")
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>'
          : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
      }
    });
  });

  // size guide modal
  var sgBg = document.getElementById("pdp-sizeguide-bg");
  var sg   = document.getElementById("pdp-sizeguide");
  function openSG() { if (!sg) return; sg.classList.add("open"); sgBg.classList.add("open"); sg.setAttribute("aria-hidden", "false"); document.body.classList.add("no-scroll"); }
  function closeSG() { if (!sg) return; sg.classList.remove("open"); sgBg.classList.remove("open"); sg.setAttribute("aria-hidden", "true"); document.body.classList.remove("no-scroll"); }
  ["pdp-sizeguide-open", "pdp-sizeguide-open-2"].forEach(function (id) { var el = document.getElementById(id); if (el) el.addEventListener("click", openSG); });
  var sgClose = document.getElementById("pdp-sizeguide-close");
  if (sgClose) sgClose.addEventListener("click", closeSG);
  if (sgBg) sgBg.addEventListener("click", closeSG);

  // zoom lightbox
  var zoomBg = document.getElementById("pdp-zoombg");
  var zoomImg = document.getElementById("pdp-zoom-img");
  var zoomBtn = document.getElementById("pdp-zoom-btn");
  var zoomClose = document.getElementById("pdp-zoom-close");
  function openZoom() { if (!zoomBg) return; if (mainPhoto && zoomImg) zoomImg.src = mainPhoto.src; zoomBg.style.display = "flex"; document.body.classList.add("no-scroll"); }
  function closeZoom() { if (!zoomBg) return; zoomBg.style.display = "none"; document.body.classList.remove("no-scroll"); }
  if (zoomBtn) zoomBtn.addEventListener("click", openZoom);
  if (zoomClose) zoomClose.addEventListener("click", closeZoom);
  if (zoomBg) zoomBg.addEventListener("click", function (e) { if (e.target === zoomBg) closeZoom(); });

  // pincode ETA
  var pin = document.getElementById("pdp-pin");
  var pinBtn = document.getElementById("pdp-pin-check");
  var pinOut = document.getElementById("pdp-pin-out");
  function checkPin() {
    if (!pinOut) return;
    pinOut.style.display = "block";
    var v = (pin.value || "").replace(/\D/g, "");
    if (!/^\d{6}$/.test(v)) { pinOut.className = "pin-out err"; pinOut.textContent = "Enter a valid 6-digit pincode."; return; }
    var metro = ["11", "40", "56", "60", "70", "50"].some(function (p) { return v.indexOf(p) === 0; });
    pinOut.className = "pin-out";
    pinOut.innerHTML = "<strong>" + (metro ? "2-3 days" : "4-7 days") + "</strong> · " + (metro ? "Metro express" : "Standard") + " · COD available · Free over ₹999";
  }
  if (pinBtn) pinBtn.addEventListener("click", checkPin);
  if (pin) pin.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); checkPin(); } });

  // sticky bar visibility
  var buybar = document.getElementById("pdp-buybar");
  if (buybar && addBtn) {
    var io = new IntersectionObserver(function (entries) {
      buybar.classList.toggle("visible", !entries[0].isIntersecting);
    }, { threshold: 0 });
    io.observe(addBtn);
  }

  render();
})();
</script>

