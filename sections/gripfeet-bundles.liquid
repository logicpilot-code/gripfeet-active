<section class="wrap section" id="bundles">
  <div class="section-head">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <div class="right"><span class="muted" style="font-size:13px">Free shipping over ₹999 · COD available</span></div>
  </div>

  <div class="bundles">
    {%- for block in section.blocks -%}
      {%- if block.type == "bundle" -%}
        <div class="bundle{% if block.settings.featured %} featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.save_label != blank -%}
            <span class="save">{{ block.settings.save_label }}</span>
          {%- endif -%}
          <div class="tier-label">{{ block.settings.tag }}</div>
          <h3 class="tier-name">{{ block.settings.name }}</h3>
          <div class="visual">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" width="600" height="400" loading="lazy" style="width:100%;height:100%;object-fit:cover">
            {%- else -%}
              <div class="ph{% if block.settings.featured %} ph-dark{% endif %}">
                <span class="ph-label">{{ block.settings.name }} · folded stack</span>
                <span class="ph-corner">GF · BDL</span>
              </div>
            {%- endif -%}
          </div>
          <p class="bdesc">{{ block.settings.desc }}</p>
          <div class="price-row">
            <span class="price-now">₹{{ block.settings.price }}</span>
            <span class="price-then">₹{{ block.settings.was }}</span>
          </div>
          <a href="{{ block.settings.link }}" class="btn btn-outline cta-btn">
            {{ block.settings.cta }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Bundles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pack & save · Bundles" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy them in threes." }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "text",         "id": "tag",        "label": "Tag",          "default": "Duo" },
        { "type": "text",         "id": "name",       "label": "Name",         "default": "Studio Duo" },
        { "type": "text",         "id": "save_label", "label": "Save label",   "default": "Save 12%" },
        { "type": "textarea",     "id": "desc",       "label": "Description",  "default": "Two pairs from the same range." },
        { "type": "text",         "id": "price",      "label": "Price",        "default": "549" },
        { "type": "text",         "id": "was",        "label": "Was",          "default": "598" },
        { "type": "text",         "id": "cta",        "label": "CTA",          "default": "Add to bag" },
        { "type": "url",          "id": "link",       "label": "Link" },
        { "type": "image_picker", "id": "image",      "label": "Image" },
        { "type": "checkbox",     "id": "featured",   "label": "Featured",     "default": false }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{
    "name": "Gripfeet — Bundles",
    "blocks": [
      { "type": "bundle", "settings": { "tag": "Duo",   "name": "Studio Duo",   "save_label": "Save 12%", "desc": "Two pairs, same range.", "price": "549",  "was": "598",  "cta": "Add to bag" } },
      { "type": "bundle", "settings": { "tag": "Trio",  "name": "Studio Three", "save_label": "Save 21%", "desc": "Three pairs — your full rotation.", "price": "699",  "was": "897",  "cta": "Add to bag", "featured": true } },
      { "type": "bundle", "settings": { "tag": "Six",   "name": "Six-Pack",     "save_label": "Save 39%", "desc": "Six pairs for daily carry.", "price": "1099", "was": "1794", "cta": "Add to bag" } }
    ]
  }]
}
{% endschema %}