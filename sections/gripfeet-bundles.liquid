{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<section class="gf-wrap section" id="bundles">
  <div class="gf-section-head">
    <div class="gf-section-head__left">
      <span class="gf-eyebrow"><span class="gf-dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="gf-h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <div class="gf-section-head__right">
      <span style="color:var(--gf-ink-2);font-size:13px">{{ section.settings.note }}</span>
    </div>
  </div>
  <div class="bundles">
    {%- for block in section.blocks -%}
      {%- if block.type == 'bundle' -%}
        <div class="bundle{% if block.settings.featured %} featured{% endif %}" {{ block.shopify_attributes }}>
          <span class="save">{{ block.settings.save }}</span>
          <div class="tier-label">{{ block.settings.tag }}</div>
          <div class="tier-name">{{ block.settings.name }}</div>
          <div class="visual">
            <div class="gf-ph{% if block.settings.featured %} gf-ph--dark{% endif %}" style="width:100%;height:100%">
              <span class="gf-ph__label">{{ block.settings.name }} · bundle shot</span>
            </div>
          </div>
          <p class="bdesc">{{ block.settings.desc }}</p>
          <ul>
            {%- assign lines = block.settings.list | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- unless line == blank -%}
                <li>
                  <span class="tick"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>
                  {{ line | strip }}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
          <div class="price-row">
            <span class="price-now">{{ block.settings.price }}</span>
            <span class="price-then">{{ block.settings.price_was }}</span>
          </div>
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="gf-btn{% if block.settings.featured %} gf-btn--light{% else %} gf-btn--primary{% endif %} cta-btn">{{ block.settings.cta }}</a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name":"Gripfeet — Bundles (Active)","tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Pack & save · Bundles"},
    {"type":"text","id":"heading","label":"Heading","default":"Buy them in threes."},
    {"type":"text","id":"note","label":"Note","default":"Free shipping over ₹999 · COD available"}
  ],
  "blocks":[{"type":"bundle","name":"Bundle","settings":[
    {"type":"text","id":"tag","label":"Tag","default":"Starter"},
    {"type":"text","id":"name","label":"Name","default":"Studio Pair"},
    {"type":"text","id":"save","label":"Save badge","default":"Save 30%"},
    {"type":"checkbox","id":"featured","label":"Featured (dark)","default":false},
    {"type":"textarea","id":"desc","label":"Description","default":"One pack from the Ankle or Crew range."},
    {"type":"textarea","id":"list","label":"Checklist (one per line)","default":"Set of 2 or 3 pairs
Any colour story
