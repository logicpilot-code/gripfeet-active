    {"type":"text","id":"price","label":"Price","default":"₹699"},
    {"type":"text","id":"price_was","label":"Was price","default":"₹999"},
    {"type":"text","id":"cta","label":"CTA","default":"Pick a pack"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "max_blocks":3,
  "presets":[{"name":"Gripfeet — Bundles (Active)","blocks":[
