{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
{%- if section.settings.phone != blank -%}
  <a
    class="gf-wa"
    href="https://wa.me/{{ section.settings.phone | remove: '+' | remove: ' ' | remove: '-' }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
  >
    <span class="gf-wa__dot"></span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.6 11.6 0 0 0 4 19.7L3 23l3.4-1A11.6 11.6 0 1 0 20.5 3.5Zm-8.5 18a9.5 9.5 0 0 1-4.8-1.3l-.3-.2-2 .6.6-2-.2-.3A9.5 9.5 0 1 1 12 21.5Zm5.4-7c-.3-.2-1.7-.9-2-1s-.5-.1-.6.2-.7.9-.8 1.1-.3.2-.5.1a7.8 7.8 0 0 1-3.9-3.4c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.8.4 3 3 0 0 0-1 2.3c0 1.4 1 2.7 1.1 2.9s2 3.2 5 4.5c1.8.8 2.5.8 3.4.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3Z"/></svg>
    <span class="gf-wa__label">{{ section.settings.label }}</span>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "GF WhatsApp",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "phone", "label": "WhatsApp number (international format, e.g. +919876543210)" },
    { "type": "text", "id": "label", "label": "Button label", "default": "Chat with us" }
  ],
  "presets": [{ "name": "GF WhatsApp" }]
}
{% endschema %}
