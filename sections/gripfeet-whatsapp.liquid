<a href="https://wa.me/{{ section.settings.number | remove: '+' | remove: ' ' }}" class="gf-wa" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <span class="gf-wa__dot"></span>
  <span class="gf-wa__label">{{ section.settings.label }}</span>
</a>
{% schema %}
{
  "name":"GF WhatsApp Button","tag":"section",
  "settings":[
    {"type":"text","id":"label","label":"Button label","default":"Chat with us"},
    {"type":"text","id":"number","label":"WhatsApp number","default":"+919999999999"}
  ],
  "presets":[{"name":"GF WhatsApp Button"}]
}
{% endschema %}
