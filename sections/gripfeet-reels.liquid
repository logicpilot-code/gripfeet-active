{%- comment -%}
  Instagram Reels scroller. Manual reel cards now (thumbnail + link, 9:16).
  For AUTO-syncing latest Reels, add an Instagram-feed app (e.g. Instafeed / Reelup) once posting is consistent.
{%- endcomment -%}
<style>
  .gf-reels .section-head { align-items: flex-end; }
  .gf-reels-handle { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-2); display: inline-flex; align-items: center; gap: 8px; }
  .gf-reels-handle:hover { color: var(--accent); }
  .gf-reels-track { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(200px, 42vw, 260px); gap: clamp(12px, 1.4vw, 18px); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; margin-top: clamp(22px, 3vw, 38px); }
  .gf-reels-track::-webkit-scrollbar { display: none; }
  .gf-reel { scroll-snap-align: start; position: relative; aspect-ratio: 9 / 16; border-radius: var(--radius); overflow: hidden; background: var(--cream); display: block; }
  .gf-reel img, .gf-reel .ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gf-reel .scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,0.42), transparent 45%); }
  .gf-reel .play { position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.92); display: inline-flex; align-items: center; justify-content: center; color: var(--ink); }
  .gf-reel .cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 14px; color: #fff; font-size: 13px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .gf-reel .ig { position: absolute; top: 12px; left: 12px; z-index: 2; color: #fff; opacity: .92; }
  .gf-reel img { transition: transform .5s var(--ease-out); }
  .gf-reel:hover img { transform: scale(1.05); }
</style>

<section class="section gf-reels">
  <div class="wrap">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
      </div>
      <div class="right">
        <a href="{{ section.settings.handle_url | default: '#' }}" class="gf-reels-handle" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="currentColor"/></svg>
          {{ section.settings.handle | default: '@gripfeet' }}
        </a>
      </div>
    </div>

    <div class="gf-reels-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'reel' -%}
          <a class="gf-reel" href="{{ block.settings.link | default: section.settings.handle_url | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 640 }}" alt="{{ block.settings.caption | escape }}" width="360" height="640" loading="lazy">
            {%- else -%}
              <div class="ph"><span class="ph-label">Reel</span></div>
            {%- endif -%}
            <span class="ig"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="currentColor"/></svg></span>
            <span class="play"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
            <div class="scrim"></div>
            {%- if block.settings.caption != blank -%}<div class="cap">{{ block.settings.caption }}</div>{%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GF Instagram Reels",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As seen on Instagram" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the wild." },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@gripfeet" },
    { "type": "url", "id": "handle_url", "label": "Instagram profile URL" },
    { "type": "paragraph", "content": "Add reel cards below (thumbnail + link). To auto-sync your latest Reels, install an Instagram-feed app once you're posting consistently." }
  ],
  "blocks": [
    { "type": "reel", "name": "Reel", "settings": [
      { "type": "image_picker", "id": "image", "label": "Thumbnail (9:16)" },
      { "type": "url", "id": "link", "label": "Reel link" },
      { "type": "text", "id": "caption", "label": "Caption" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "GF Instagram Reels",
    "blocks": [
      { "type": "reel", "settings": { "caption": "Grip check on hardwood" } },
      { "type": "reel", "settings": { "caption": "Sunrise Pilates" } },
      { "type": "reel", "settings": { "caption": "No-slip, no-show" } },
      { "type": "reel", "settings": { "caption": "Lil Steps first runs" } }
    ]
  }]
}
{% endschema %}
