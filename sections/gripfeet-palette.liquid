<section class="wrap section tight" id="palette">
  <div class="section-head">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <div class="right">
      <span class="muted" style="font-size:13px;max-width:30ch">{{ section.settings.subtext }}</span>
    </div>
  </div>

  <div class="palette-groups">
    {%- for block in section.blocks -%}
      {%- if block.type == "group" -%}
        <div class="palette-group" {{ block.shopify_attributes }}>
          <span class="palette-label">{{ block.settings.title }}</span>
          <div class="palette-chips">
            {%- assign colors = block.settings.colors | split: "," -%}
            {%- assign labels = block.settings.labels | split: "," -%}
            {%- for color in colors -%}
              {%- assign idx = forloop.index0 -%}
              {%- assign lbl = labels[idx] | strip -%}
              <div class="palette-chip">
                <span class="dot" style="background:{{ color | strip }};box-shadow:inset 0 0 0 1px rgba(10,10,10,0.12)"></span>
                <span class="lab">{{ lbl }}</span>
                <span class="hex">{{ color | strip }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Signature Palette",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",  "default": "Signature palette" },
    { "type": "text", "id": "heading",  "label": "Heading",  "default": "Colours that get along." },
    { "type": "text", "id": "subtext",  "label": "Subtext",  "default": "Thoughtfully curated for comfort, style & everyday function." }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Colour group",
      "settings": [
        { "type": "text", "id": "title",  "label": "Group title", "default": "Core Neutrals" },
        { "type": "text", "id": "colors", "label": "Hex values (comma-separated)", "default": "#FFFFFF,#0E0E0E,#C9B9A3,#9C9A92" },
        { "type": "text", "id": "labels", "label": "Labels (comma-separated)",     "default": "White,Black,Warm Beige,Grey" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Gripfeet — Signature Palette",
    "blocks": [
      { "type": "group", "settings": { "title": "Core Neutrals",       "colors": "#FFFFFF,#0E0E0E,#C9B9A3,#9C9A92,#8B7355", "labels": "White,Black,Warm Beige,Grey,Dusty Brown" } },
      { "type": "group", "settings": { "title": "Soft Pastels",        "colors": "#B2C4B0,#C8B8D8,#F5E6A0,#A8D8C4,#B8D4E8,#F4C4C4", "labels": "Sage,Lavender,Butter,Mint,Ice Blue,Pink" } },
      { "type": "group", "settings": { "title": "Heritage Sport Tones","colors": "#C1392B,#1E2E4F,#404040", "labels": "Red,Navy,Deep Grey" } }
    ]
  }]
}
{% endschema %}