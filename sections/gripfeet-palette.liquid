{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<section class="gf-wrap section tight" id="palette">
  <div class="gf-section-head">
    <div class="gf-section-head__left">
      <span class="gf-eyebrow"><span class="gf-dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="gf-h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <div class="gf-section-head__right">
      <span style="font-size:13px;color:var(--gf-ink-2);max-width:30ch">{{ section.settings.desc }}</span>
    </div>
  </div>
  <div class="palette-groups">
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        <div class="palette-group" {{ block.shopify_attributes }}>
          <span class="palette-label">{{ block.settings.group_name }}</span>
          <div class="palette-chips">
            {%- assign chip_list = block.settings.chips | split: '|' -%}
            {%- for chip in chip_list -%}
              {%- assign parts = chip | split: ':' -%}
              <div class="palette-chip">
                <span class="dot" style="background:{{ parts[0] }};box-shadow:inset 0 0 0 1px rgba(0,0,0,0.12)"></span>
                <span class="lab">{{ parts[1] }}</span>
                <span class="hex">{{ parts[0] }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name":"Gripfeet — Palette (Active)","tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Signature palette"},
    {"type":"text","id":"heading","label":"Heading","default":"Colours that get along."},
    {"type":"text","id":"desc","label":"Description","default":"Thoughtfully curated for comfort, style & everyday function."}
  ],
  "blocks":[{"type":"group","name":"Colour group","settings":[
    {"type":"text","id":"group_name","label":"Group name","default":"Core Neutrals"},
    {"type":"text","id":"chips","label":"Chips (hex:name|hex:name)","default":"#FFFFFF:White|#0A0A0A:Black|#D9C9B3:Warm Beige"}
  ]}],
  "max_blocks":3,
  "presets":[{"name":"Gripfeet — Palette (Active)","blocks":[
    {"type":"group","settings":{"group_name":"Core Neutrals","chips":"#FFFFFF:White|#0A0A0A:Black|#D9C9B3:Warm Beige|#A9ACA9:Grey|#7A6A57:Dusty Brown"}},
    {"type":"group","settings":{"group_name":"Soft Pastels","chips":"#B6C5A8:Sage|#C7B9D8:Lavender|#F1E2A6:Butter Yellow|#BFE0CE:Mint|#C6D9E2:Ice Blue|#F1C9CF:Pink"}},
    {"type":"group","settings":{"group_name":"Heritage Sport Tones","chips":"#9E2A2A:Red|#1E2E4F:Navy|#3A3D3F:Deep Grey"}}
  ]}]
}
{% endschema %}
