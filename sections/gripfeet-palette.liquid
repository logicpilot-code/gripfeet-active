{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<section class="gf-wrap gf-section gf-section--tight">
  <div class="gf-section-head">
    <div class="gf-section-head__left">
      <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="gf-h-section">
        {{ section.settings.heading }}
        {%- if section.settings.heading_italic != blank -%}
          <em class="gf-italic">{{ section.settings.heading_italic }}</em>
        {%- endif -%}
      </h2>
    </div>
    <div class="gf-section-head__right">
      <span class="gf-muted" style="font-size:13px;max-width:28ch">{{ section.settings.desc }}</span>
    </div>
  </div>

  <div class="gf-palette-groups">
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        <div class="gf-palette-group" {{ block.shopify_attributes }}>
          <span class="gf-palette-label">{{ block.settings.group_name }}</span>
          <div class="gf-palette-chips">
            {%- assign chip_data = block.settings.chips | split: '|' -%}
            {%- for chip in chip_data -%}
              {%- unless chip == blank -%}
                {%- assign parts = chip | split: ':' -%}
                {%- assign chip_hex   = parts[0] | strip -%}
                {%- assign chip_label = parts[1] | strip -%}
                <div class="gf-palette-chip">
                  <span class="gf-palette-chip__dot" style="background:{{ chip_hex }};box-shadow:inset 0 0 0 1px rgba(10,10,10,.1)"></span>
                  <span class="gf-palette-chip__lab">{{ chip_label }}</span>
                  <span class="gf-palette-chip__hex">{{ chip_hex }}</span>
                </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GF Signature Palette",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow",        "label": "Eyebrow",        "default": "05b — Signature palette · Thoughtfully curated" },
    { "type": "text", "id": "heading",        "label": "Heading",        "default": "Colours" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic", "default": "that get along." },
    { "type": "text", "id": "desc",           "label": "Description",    "default": "Thoughtfully curated colours for comfort, style & everyday function." }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Colour Group",
      "settings": [
        { "type": "text", "id": "group_name", "label": "Group name", "default": "Core Neutrals" },
        {
          "type": "textarea",
          "id": "chips",
          "label": "Chips (format: #HEX:Name|#HEX:Name)",
          "default": "#FFFFFF:White|#0A0A0A:Black|#D9C9B3:Warm Beige|#A9ACA9:Grey|#7A6A57:Dusty Brown"
        }
      ]
    }
  ],
  "presets": [{
    "name": "GF Signature Palette",
    "blocks": [
      { "type": "group", "settings": { "group_name": "Core Neutrals",        "chips": "#FFFFFF:White|#0A0A0A:Black|#D9C9B3:Warm Beige|#A9ACA9:Grey|#7A6A57:Dusty Brown" } },
      { "type": "group", "settings": { "group_name": "Soft Pastels",         "chips": "#B6C5A8:Sage|#C7B9D8:Lavender|#F1E2A6:Butter Yellow|#BFE0CE:Mint|#C6D9E2:Ice Blue|#F1C9CF:Pink" } },
      { "type": "group", "settings": { "group_name": "Heritage Sport Tones", "chips": "#9E2A2A:Red|#1E2E4F:Navy|#3A3D3F:Deep Grey" } }
    ]
  }]
}
{% endschema %}
