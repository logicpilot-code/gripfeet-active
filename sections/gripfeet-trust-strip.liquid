{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<div class="gf-wrap">
  <div class="gf-trust">
    <div class="gf-trust__inner">
      {%- for block in section.blocks -%}
        <div class="gf-trust__item" {{ block.shopify_attributes }}>
          <span class="gf-trust__ico" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19c4-4 8-6 14-14"/></svg>
              {%- when 'grip' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="17" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="17" cy="12" r="1"/><circle cx="7" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="17" cy="17" r="1"/></svg>
              {%- when 'fit' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
              {%- when 'washer' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="5"/><circle cx="8" cy="6" r=".5" fill="currentColor"/></svg>
              {%- when 'india' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3.5 0-6 2.5-6 6 0 4 6 12 6 12s6-8 6-12c0-3.5-2.5-6-6-6Z"/><circle cx="12" cy="9" r="2"/></svg>
              {%- when 'truck' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
              {%- else -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
            {%- endcase -%}
          </span>
          <div>
            {{ block.settings.label }}
            <small>{{ block.settings.sublabel }}</small>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gripfeet — Trust Strip",
  "tag": "div",
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",   "label": "Leaf (Supima)" },
            { "value": "grip",   "label": "Grip (Silicone)" },
            { "value": "fit",    "label": "Fit" },
            { "value": "washer", "label": "Washer (Care)" },
            { "value": "india",  "label": "India" },
            { "value": "truck",  "label": "Truck (Shipping)" },
            { "value": "check",  "label": "Check" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "label",    "label": "Label",    "default": "Stretch Supima Yarn" },
        { "type": "text", "id": "sublabel", "label": "Sub-label","default": "Soft, breathable & durable" }
      ]
    }
  ],
  "presets": [{
    "name": "Gripfeet — Trust Strip",
    "blocks": [
      { "type": "item", "settings": { "icon": "leaf",   "label": "Stretch Supima Yarn",    "sublabel": "Soft, breathable & durable" } },
      { "type": "item", "settings": { "icon": "grip",   "label": "Superior Antislip Grip", "sublabel": "100% silicone, full sole" } },
      { "type": "item", "settings": { "icon": "fit",    "label": "Perfect Fit",            "sublabel": "Available in 2–3 sizes" } },
      { "type": "item", "settings": { "icon": "washer", "label": "Easy Care",              "sublabel": "Machine washable" } }
    ]
  }]
}
{% endschema %}
