{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<div class="gf-wrap">
  <div class="gf-trust">
    <div class="gf-trust__inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div class="gf-trust__item" {{ block.shopify_attributes }}>
            <span class="gf-trust__ico">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19c4-4 8-6 14-14"/></svg>
                {%- when 'grip' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="17" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="17" cy="12" r="1"/><circle cx="7" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="17" cy="17" r="1"/></svg>
                {%- when 'fit' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                {%- when 'washer' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="5"/><circle cx="8" cy="6" r=".5" fill="currentColor"/></svg>
              {%- endcase -%}
            </span>
            <div>
              <div class="gf-trust__t">{{ block.settings.label }}</div>
              <small class="gf-trust__s">{{ block.settings.sublabel }}</small>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Gripfeet — Trust Strip (Active)","tag":"section","settings":[],
  "blocks":[{"type":"item","name":"Trust item","settings":[
    {"type":"select","id":"icon","label":"Icon","options":[{"value":"leaf","label":"Leaf"},{"value":"grip","label":"Grip"},{"value":"fit","label":"Fit"},{"value":"washer","label":"Washer"}],"default":"leaf"},
    {"type":"text","id":"label","label":"Label","default":"Stretch Supima Yarn"},
    {"type":"text","id":"sublabel","label":"Sublabel","default":"Soft, breathable & durable"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"Gripfeet — Trust Strip (Active)","blocks":[
    {"type":"item","settings":{"icon":"leaf","label":"Stretch Supima Yarn","sublabel":"Soft, breathable & durable"}},
    {"type":"item","settings":{"icon":"grip","label":"Superior Antislip Grip","sublabel":"100% silicone, full sole"}},
    {"type":"item","settings":{"icon":"fit","label":"Perfect Fit","sublabel":"Available in 2–3 sizes"}},
    {"type":"item","settings":{"icon":"washer","label":"Easy Care","sublabel":"Machine washable"}}
  ]}]
}
{% endschema %}
