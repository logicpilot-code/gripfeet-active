<section class="wrap">
  <div class="newsletter">
    <div>
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h3 style="margin-top:16px">{{ section.settings.heading }}</h3>
      <p>{{ section.settings.body }}</p>
    </div>
    <div>
      {%- form "customer" -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email" name="contact[email]"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn-primary">
          {{ section.settings.cta }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </button>
      {%- endform -%}
      <div class="fine">{{ section.settings.fine }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",     "label": "Eyebrow",     "default": "Letters from the studio" },
    { "type": "text",     "id": "heading",     "label": "Heading",     "default": "Drop your email, get ₹200 off." },
    { "type": "textarea", "id": "body",        "label": "Body",        "default": "One quiet note a month — new colourways, studio drops, the occasional travel-essentials list." },
    { "type": "text",     "id": "placeholder", "label": "Placeholder", "default": "you@example.com" },
    { "type": "text",     "id": "cta",         "label": "CTA",         "default": "Subscribe" },
    { "type": "text",     "id": "fine",        "label": "Fine print",  "default": "By subscribing you agree to receive marketing emails. Unsubscribe any time." }
  ],
  "presets": [{ "name": "Gripfeet — Newsletter" }]
}
{% endschema %}