{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<div class="gf-wrap">
  <div class="newsletter">
    <div>
      <h3>{{ section.settings.heading }}</h3>
      <p>{{ section.settings.desc }}</p>
    </div>
    <div>
      {% form 'customer', id: 'gf-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter" style="padding:0;border:0">
          <form class="" onsubmit="event.preventDefault();this.closest('.newsletter').querySelector('form').style.display='none';this.closest('.newsletter').querySelector('.success').style.display='block'">
            <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'you@example.com' }}" autocomplete="email" required>
            <button type="submit" class="gf-btn gf-btn--primary gf-btn--sm">{{ section.settings.btn_label | default: 'Subscribe' }}</button>
          </form>
        </div>
        <div class="success" style="display:none">
          <p class="success" style="font-weight:800;font-size:22px">You're in. ✓</p>
        </div>
        <p class="fine">{{ section.settings.fine }}</p>
      {% endform %}
    </div>
  </div>
</div>
{% schema %}
{
  "name":"Gripfeet — Newsletter (Active)","tag":"section",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Drop your email,"},
    {"type":"textarea","id":"desc","label":"Description","default":"One quiet note a month — new colourways, studio drops, the occasional travel essentials list. No spam, no neon banners."},
    {"type":"text","id":"placeholder","label":"Input placeholder","default":"you@example.com"},
    {"type":"text","id":"btn_label","label":"Button label","default":"Subscribe"},
    {"type":"text","id":"fine","label":"Fine print","default":"No spam. Unsubscribe anytime."}
  ],
  "presets":[{"name":"Gripfeet — Newsletter (Active)"}]
}
{% endschema %}
