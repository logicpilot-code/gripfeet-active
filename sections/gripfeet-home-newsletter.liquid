{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<div class="gf-wrap">
  <div class="gf-newsletter">
    <div>
      <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
      <h3 style="margin-top:18px">
        {{ section.settings.heading }}
        {%- if section.settings.heading_italic != blank -%}
          <em class="gf-italic">{{ section.settings.heading_italic }}</em>
        {%- endif -%}
      </h3>
      <p>{{ section.settings.desc }}</p>
    </div>

    <div>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,email subscriber">
        <div class="gf-newsletter__form">
          <input
            class="gf-newsletter__input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            required
            aria-label="{{ section.settings.placeholder }}"
          >
          <button class="gf-newsletter__submit" type="submit">
            {{ section.settings.btn_label }}
            <svg class="gf-arrow-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <div class="gf-newsletter__success">Welcome in. Check your inbox — your ₹200 off is on its way.</div>
        {%- endif -%}
      {%- endform -%}
      <p class="gf-newsletter__fine">By subscribing you agree to receive marketing emails. Unsubscribe any time.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gripfeet — Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",         "label": "Eyebrow",      "default": "09 — Letters from the studio" },
    { "type": "text",     "id": "heading",         "label": "Heading",      "default": "Drop your" },
    { "type": "text",     "id": "heading_italic",  "label": "Heading italic","default": "email," },
    { "type": "textarea", "id": "desc",            "label": "Description",  "default": "One quiet note a month — new colourways, studio drops, the occasional travel essentials list. No spam, no neon banners." },
    { "type": "text",     "id": "placeholder",     "label": "Input placeholder","default": "you@example.com" },
    { "type": "text",     "id": "btn_label",       "label": "Button label",  "default": "Subscribe" }
  ],
  "presets": [{ "name": "Gripfeet — Newsletter" }]
}
{% endschema %}
