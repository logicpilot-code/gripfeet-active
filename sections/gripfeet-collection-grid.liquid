{{ 'gripfeet-collection.css' | asset_url | stylesheet_tag }}

<div class="wrap">
  <div class="col-breadcrumb">
    <a href="/">Home</a><span class="sep">/</span>
    <span class="here">{{ collection.title | default: "All Socks" }}</span>
  </div>

  <div class="col-head">
    <div>
      <h1 class="col-title">{{ collection.title | default: "All Socks" }}</h1>
      {%- if collection.description != blank -%}
        <p class="col-intro">{{ collection.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}
    </div>
    <div class="col-sort">
      <span>Sort</span>
      <div class="sort-select">
        <select id="gf-sort" onchange="window.location.href=this.value">
          <option value="?sort_by=manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Featured</option>
          <option value="?sort_by=price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price: low to high</option>
          <option value="?sort_by=price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price: high to low</option>
          <option value="?sort_by=best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Best selling</option>
        </select>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
    </div>
  </div>

  <div class="col-layout">
    <!-- Filter rail (desktop) -->
    <aside class="col-rail">
      <div class="rail-head">
        <span>Filters</span>
        <a href="{{ collection.url }}" class="rail-clear">Clear all</a>
      </div>
      {%- for filter in collection.filters -%}
        <div class="filter-group open">
          <button class="fg-head" onclick="this.closest('.filter-group').classList.toggle('open')">
            {{ filter.label }}
            <span class="fg-ico">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="fg-body">
            {%- for value in filter.values -%}
              <a href="{{ value.url_to_add }}" class="facet{% if value.active %} on{% endif %}">
                <span class="box">{% if value.active %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{% endif %}</span>
                <span class="flab">{{ value.label }}</span>
                <span class="fcount">{{ value.count }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </aside>

    <!-- Main grid -->
    <div>
      <div class="col-toolbar">
        <span class="col-count">{{ collection.products_count }} products</span>
      </div>

      <div class="col-grid">
        {%- for product in collection.products -%}
          <a class="pcard" href="{{ product.url }}">
            <div class="pimg">
              {%- if product.compare_at_price_max > product.price_min -%}
                {%- assign off = product.compare_at_price_max | minus: product.price_min | times: 100 | divided_by: product.compare_at_price_max -%}
                <span class="save-tag">−{{ off }}%</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" width="600" height="600" loading="lazy" style="width:100%;height:100%;object-fit:cover">
              {%- else -%}
                <div class="ph" style="width:100%;height:100%">
                  <span class="ph-label">{{ product.title }}</span>
                  <span class="ph-corner">{{ product.handle | upcase | truncate: 8, "" }}</span>
                </div>
              {%- endif -%}
            </div>
            <div class="prange">{{ product.type }}</div>
            <div class="pname">{{ product.title }}</div>
            <div class="pprice">
              {%- if product.compare_at_price_max > product.price_min -%}
                <span class="was">₹{{ product.compare_at_price_max | money_without_currency }}</span>
              {%- endif -%}
              ₹{{ product.price_min | money_without_currency }}
            </div>
          </a>
        {%- else -%}
          <div class="col-empty" style="grid-column:1/-1">
            <h3>No products found</h3>
            <p>Try adjusting your filters.</p>
            <a href="{{ collection.url }}" class="btn btn-primary">Clear filters</a>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="col-foot">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gripfeet — Collection Grid",
  "tag": "section",
  "presets": [{ "name": "Gripfeet — Collection Grid" }]
}
{% endschema %}