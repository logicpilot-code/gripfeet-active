{%- comment -%} Homepage FAQ — pastel accordion + lifestyle image (Brinda ref: Hunnit FAQ) {%- endcomment -%}
<style>
  .gf-faq { background: var(--gf-faq-bg, #ECE7F3); }
  .gf-faq .wrap { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 4.5vw, 72px); align-items: center; }
  .gf-faq .section-head { margin-bottom: clamp(20px, 2.6vw, 34px); }
  .gf-faq-list { border-top: 1px solid rgba(10,10,10,0.12); }
  .gf-faq-item { border-bottom: 1px solid rgba(10,10,10,0.12); }
  .gf-faq-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 20px 2px; text-align: left; cursor: pointer; }
  .gf-faq-q .qt { font-weight: 700; font-size: clamp(15px, 1.3vw, 17px); letter-spacing: -0.01em; color: var(--ink); line-height: 1.35; }
  .gf-faq-ic { position: relative; width: 15px; height: 15px; flex-shrink: 0; color: var(--ink); }
  .gf-faq-ic::before, .gf-faq-ic::after { content: ""; position: absolute; background: currentColor; border-radius: 2px; transition: transform .3s var(--ease); }
  .gf-faq-ic::before { left: 0; top: 6.5px; width: 15px; height: 2px; }
  .gf-faq-ic::after  { left: 6.5px; top: 0; width: 2px; height: 15px; }
  .gf-faq-item.open .gf-faq-ic::after { transform: scaleY(0); }
  .gf-faq-a-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .32s var(--ease); }
  .gf-faq-item.open .gf-faq-a-wrap { grid-template-rows: 1fr; }
  .gf-faq-a { overflow: hidden; }
  .gf-faq-a p { margin: 0 0 20px; font-size: 14.5px; line-height: 1.6; color: var(--ink-2); max-width: 52ch; }
  .gf-faq-visual { aspect-ratio: 5 / 6; border-radius: var(--radius); overflow: hidden; }
  .gf-faq-visual .ph, .gf-faq-visual img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 860px) { .gf-faq .wrap { grid-template-columns: 1fr; } .gf-faq-visual { grid-row: 1; aspect-ratio: 16 / 12; } }
</style>

<section class="section gf-faq" style="{% if section.settings.bg_color != blank %}--gf-faq-bg:{{ section.settings.bg_color }};{% endif %}">
  <div class="wrap">
    <div class="gf-faq-main">
      <div class="section-head">
        <div class="left">
          <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
          <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
        </div>
      </div>
      <div class="gf-faq-list" id="gf-faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="gf-faq-item{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="gf-faq-q">
                <span class="qt">{{ block.settings.question }}</span>
                <span class="gf-faq-ic" aria-hidden="true"></span>
              </button>
              <div class="gf-faq-a-wrap"><div class="gf-faq-a"><p>{{ block.settings.answer }}</p></div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="gf-faq-visual">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" width="1000" height="1200" loading="lazy">
      {%- else -%}
        <div class="ph has-photo" style="width:100%;height:100%">
          <img class="ph-img" src="{{ 'gf-story.jpg' | asset_url }}" alt="Gripfeet" width="1000" height="1200" loading="lazy">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function () {
  var list = document.getElementById('gf-faq-list');
  if (!list) return;
  list.querySelectorAll('.gf-faq-q').forEach(function (q) {
    q.addEventListener('click', function () { q.closest('.gf-faq-item').classList.toggle('open'); });
  });
})();
</script>

{% schema %}
{
  "name": "GF FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ECE7F3" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "textarea", "id": "answer", "label": "Answer" }
    ] }
  ],
  "max_blocks": 10,
  "presets": [{
    "name": "GF FAQ",
    "blocks": [
      { "type": "faq", "settings": { "question": "Which sock is right for me?", "answer": "Mat Masters for studio and everyday, Active Hold for sport and training, Invisible Grip for a no-show under loafers and sneakers, Lil Steps for little ones aged 0 to 5." } },
      { "type": "faq", "settings": { "question": "Are they available in all sizes?", "answer": "Yes, each range comes in 2 to 3 sizes for a proper fit. The stretchy ribbed cuff and reinforced heel keep them from sliding down." } },
      { "type": "faq", "settings": { "question": "Can I wear these for intense workouts?", "answer": "Absolutely. The full-sole silicone grip and channelled knit are built for lateral movement, gym sets and long runs, while still feeling soft enough for all-day wear." } },
      { "type": "faq", "settings": { "question": "Will they shrink or fade after washing?", "answer": "No. Cold machine wash inside out, air dry or tumble low. The Supima softens with every wash and the silicone grip lasts 80+ wears." } },
      { "type": "faq", "settings": { "question": "Where are they made?", "answer": "Knit and finished in India, with Stretch Supima cotton up top and a 100% food-grade silicone sole." } }
    ]
  }]
}
{% endschema %}
