<section class="move-band">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2400 }}"
      alt="Move band"
      width="2400" height="900"
      loading="lazy"
      style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0"
    >
  {%- else -%}
    <img
      src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=2400&auto=format&fit=crop&q=85"
      alt="Gripfeet active lifestyle"
      width="2400" height="900"
      loading="lazy"
      style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0"
    >
  {%- endif -%}
  <div class="scrim"></div>
  <h2>{{ section.settings.headline | newline_to_br }}</h2>
</section>

{% schema %}
{
  "name": "Gripfeet — Move Band",
  "tag": "section",
  "settings": [
    { "type": "textarea",     "id": "headline", "label": "Headline", "default": "Every Step, Every Day." },
    { "type": "image_picker", "id": "image",    "label": "Background image" }
  ],
  "presets": [{ "name": "Gripfeet — Move Band" }]
}
{% endschema %}