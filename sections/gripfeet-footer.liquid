{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<footer class="gf-footer">
  <div class="gf-footer__grid">
    <div class="gf-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="Gripfeet" class="gf-footer__logo" width="150" height="42">
      {%- else -%}
        <img src="{{ 'gripfeet-logo-cropped.png' | asset_url }}" alt="Gripfeet" class="gf-footer__logo" width="150" height="42">
      {%- endif -%}
      <p class="gf-footer__tag">{{ section.settings.tagline }}</p>
      <div class="gf-footer__socials">
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor"/></svg></a>{%- endif -%}
        {%- if section.settings.whatsapp != blank -%}<a href="{{ section.settings.whatsapp }}" aria-label="WhatsApp"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.6 11.6 0 0 0 4 19.7L3 23l3.4-1A11.6 11.6 0 1 0 20.5 3.5Z"/></svg></a>{%- endif -%}
      </div>
      <div class="gf-footer__region">
        <span class="rlbl">Ships to</span>
        <span class="rval">{{ section.settings.ships_to }}</span>
      </div>
    </div>

    <div class="gf-footer__col">
      <h4>Shop</h4>
      <ul>
        <li><a href="/collections/ankle">Ankle · Mat Masters</a></li>
        <li><a href="/collections/crew">Crew · Active Hold</a></li>
        <li><a href="/collections/loafer">Loafer · Invisible Grip</a></li>
        <li><a href="/collections/kids">Kids · Lil Steps</a></li>
        <li><a href="/collections/all">All grip socks</a></li>
      </ul>
    </div>

    <div class="gf-footer__col">
      <h4>Help</h4>
      <ul>
        <li><a href="/pages/shipping">Shipping</a></li>
        <li><a href="/pages/returns">Returns & Quality</a></li>
        <li><a href="/pages/sizing-guide">Sizing guide</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="/pages/contact">Contact us</a></li>
      </ul>
    </div>

    <div class="gf-footer__col">
      <h4>Company</h4>
      <ul>
        <li><a href="/pages/our-story">Our story</a></li>
        <li><a href="/pages/made-in-india">Made in India</a></li>
        <li><a href="/blogs/journal">Journal</a></li>
      </ul>
      <div class="gf-footer__region" style="margin-top:24px">
        <span class="rlbl">Delivery</span>
        <span class="rval">{{ section.settings.delivery }}</span>
      </div>
      <div class="gf-footer__region" style="margin-top:12px">
        <span class="rlbl">Payment</span>
        <span class="rval">{{ section.settings.payment }}</span>
      </div>
    </div>
  </div>

  <div class="gf-footer__bottom" style="padding-left:var(--gf-gutter);padding-right:var(--gf-gutter);max-width:var(--gf-max);margin:0 auto">
    <span>© {{ 'now' | date: '%Y' }} Gripfeet. All rights reserved.</span>
    <div class="pay">
      <span>Visa</span><span>Mastercard</span><span>UPI</span><span>COD</span>
    </div>
    <span><a href="/policies/privacy-policy" style="color:inherit">Privacy</a> · <a href="/policies/terms-of-service" style="color:inherit">Terms</a></span>
  </div>

  <div class="gf-footer__grip">
    <div class="gf-grip-texture"></div>
    <div class="gf-grip-line">
      <span class="gf-g-dot"></span>
      Premium Grip Socks
      <span class="gf-g-dot"></span>
      Traction Triumphs
      <span class="gf-g-dot"></span>
      Made in India
    </div>
  </div>
</footer>
{% schema %}
{
  "name":"Gripfeet — Footer (Active)","tag":"section",
  "settings":[
    {"type":"image_picker","id":"logo","label":"Logo (inverted)"},
    {"type":"text","id":"tagline","label":"Tagline","default":"Premium grip socks for every step, every day. Supima up top, silicone on the sole. Knit in India."},
    {"type":"url","id":"instagram","label":"Instagram URL"},
    {"type":"url","id":"whatsapp","label":"WhatsApp URL"},
    {"type":"text","id":"ships_to","label":"Ships to","default":"Globally · Free over ₹999"},
    {"type":"text","id":"delivery","label":"Delivery","default":"4–7 business days"},
    {"type":"text","id":"payment","label":"Payment","default":"Visa · MC · UPI · COD"}
  ],
  "presets":[{"name":"Gripfeet — Footer (Active)"}]
}
{% endschema %}
