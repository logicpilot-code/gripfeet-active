{{ 'gripfeet-pages.css' | asset_url | stylesheet_tag }}

<div class="page-hero compact">
  <div class="wrap">
    <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
    <h1 class="page-hero-title">{{ section.settings.title }}</h1>
    <p class="page-hero-sub">{{ section.settings.subtitle }}</p>
  </div>
</div>

<section class="wrap section">
  <div class="contact-layout">
    <div class="contact-info">
      <h2>{{ section.settings.info_heading }}</h2>
      <p>{{ section.settings.info_body }}</p>

      <div class="contact-channels">
        <div class="channel">
          <span class="ch-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          <div>
            <strong>Email</strong>
            <span>{{ section.settings.email }}</span>
          </div>
        </div>
        <div class="channel">
          <span class="ch-ico">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          </span>
          <div>
            <strong>WhatsApp</strong>
            <span>{{ section.settings.whatsapp_label }}</span>
          </div>
        </div>
        <div class="channel">
          <span class="ch-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <div>
            <strong>Response time</strong>
            <span>{{ section.settings.hours }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form-wrap">
      {%- form "contact" -%}
        {%- if form.posted_successfully? -%}
          <div class="form-success">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p>Message sent — we typically reply within one business day.</p>
          </div>
        {%- else -%}
          <div class="form-row">
            <label for="contact-name">Name</label>
            <input type="text" id="contact-name" name="contact[name]" placeholder="Your name" required>
          </div>
          <div class="form-row">
            <label for="contact-email">Email</label>
            <input type="email" id="contact-email" name="contact[email]" placeholder="you@example.com" required>
          </div>
          <div class="form-row">
            <label for="contact-order">Order number (optional)</label>
            <input type="text" id="contact-order" name="contact[order]" placeholder="#GF-000123">
          </div>
          <div class="form-row">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="contact[body]" rows="5" placeholder="How can we help?" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            Send message
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Contact",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",         "label": "Eyebrow",        "default": "Get in touch" },
    { "type": "text",     "id": "title",            "label": "Title",          "default": "We'd love to hear from you." },
    { "type": "textarea", "id": "subtitle",         "label": "Subtitle",       "default": "Questions about your order, sizing, or anything else — we're here." },
    { "type": "text",     "id": "info_heading",     "label": "Info heading",   "default": "Our contact details" },
    { "type": "textarea", "id": "info_body",        "label": "Info body",      "default": "We're a small team, which means you'll get a real person, not a bot. Online 9am–6pm IST, Monday to Saturday." },
    { "type": "text",     "id": "email",            "label": "Email",          "default": "hello@gripfeet.in" },
    { "type": "text",     "id": "whatsapp_label",   "label": "WhatsApp label", "default": "+91 99999 99999 · tap to chat" },
    { "type": "text",     "id": "hours",            "label": "Hours",          "default": "Mon–Sat, 9am–6pm IST. Reply in 1 business day." }
  ],
  "presets": [{ "name": "Gripfeet — Contact" }]
}
{% endschema %}