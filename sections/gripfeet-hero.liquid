<section class="hero" id="home">

  <div class="hero-media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: 'Gripfeet grip socks lifestyle' }}"
        width="2400" height="1350"
        loading="eager" fetchpriority="high"
        style="width:100%;height:100%;object-fit:cover;display:block"
      >
    {%- else -%}
      <img
        src="{{ 'gf-hero.jpg' | asset_url }}"
        alt="Sprinters in warm motion blur"
        width="1920" height="1080"
        loading="eager" fetchpriority="high"
        style="width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block"
      >
    {%- endif -%}
  </div>

  <div class="hero-content fade-up">
    <div class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.headline }}</h1>
    <p class="hero-sub">{{ section.settings.subline }}</p>
    <div class="hero-actions">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn-light btn-lg">
          {{ section.settings.cta_label }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="btn btn-ghost-light btn-lg">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="hero-badges">
    {%- for block in section.blocks -%}
      {%- if block.type == "badge" -%}
        <span {{ block.shopify_attributes }}><span class="b-dot"></span>{{ block.settings.text }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "Gripfeet — Hero",
  "tag": "section",
  "settings": [
    { "type": "text",         "id": "eyebrow",         "label": "Eyebrow",         "default": "Premium Grip Socks · Traction Triumphs" },
    { "type": "text",         "id": "headline",        "label": "Headline",        "default": "Made to Grip." },
    { "type": "textarea",     "id": "subline",         "label": "Subline",         "default": "Anti-slip socks for the way you actually move: sunrise Pilates, hardwood floors, the long flight in between. Supima up top, 100% silicone on the sole." },
    { "type": "text",         "id": "cta_label",       "label": "CTA label",       "default": "Shop Grip Socks" },
    { "type": "url",          "id": "cta_link",        "label": "CTA link" },
    { "type": "text",         "id": "secondary_label", "label": "Secondary label", "default": "Shop Bundles" },
    { "type": "url",          "id": "secondary_link",  "label": "Secondary link" },
    { "type": "image_picker", "id": "image",           "label": "Hero image (16:9)" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "text", "label": "Badge text", "default": "100% Silicone Grip" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Gripfeet — Hero",
    "blocks": [
      { "type": "badge", "settings": { "text": "100% Silicone Grip" } },
      { "type": "badge", "settings": { "text": "Stretch Supima Cotton" } },
      { "type": "badge", "settings": { "text": "Made in India" } },
      { "type": "badge", "settings": { "text": "4–7 Day Global Delivery" } }
    ]
  }]
}
{% endschema %}