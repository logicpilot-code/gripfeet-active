<section class="wrap section" id="shop">
  <div class="section-head center">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="height-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == "card" -%}
        <a href="{{ block.settings.link }}" class="height-card" {{ block.shopify_attributes }}>
          <div class="frame">
            {%- if block.settings.badge != blank -%}
              <span class="badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.name }}"
                width="800" height="800"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;display:block"
              >
            {%- else -%}
              <div class="ph{% if block.settings.dark_bg %} ph-dark{% endif %}" style="width:100%;height:100%;{% if block.settings.bg_color != blank %}background:{{ block.settings.bg_color }};{% endif %}">
                <span class="ph-label">{{ block.settings.name }} · {{ block.settings.subtitle }}</span>
                <span class="ph-corner">GF</span>
              </div>
            {%- endif -%}
          </div>
          <div class="label">
            <div class="n">
              <small>{{ block.settings.subtitle }}</small>
              {{ block.settings.name }}
            </div>
            <span class="go">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GF Category Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",  "default": "By cuff height" },
    { "type": "text", "id": "heading",  "label": "Heading",  "default": "Shop by Height" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        { "type": "text",         "id": "name",     "label": "Name",     "default": "Ankle" },
        { "type": "text",         "id": "subtitle", "label": "Subtitle", "default": "Mat Masters" },
        { "type": "text",         "id": "badge",    "label": "Badge",    "default": "" },
        { "type": "url",          "id": "link",     "label": "Link" },
        { "type": "image_picker", "id": "image",    "label": "Image" },
        { "type": "color",        "id": "bg_color", "label": "Placeholder bg", "default": "#F3F0E8" },
        { "type": "checkbox",     "id": "dark_bg",  "label": "Dark placeholder", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "GF Category Grid",
    "blocks": [
      { "type": "card", "settings": { "name": "Loafer", "subtitle": "Invisible Grip", "bg_color": "#EFE9DD" } },
      { "type": "card", "settings": { "name": "Ankle",  "subtitle": "Mat Masters",    "bg_color": "#F3F0E8", "badge": "Bestseller" } },
      { "type": "card", "settings": { "name": "Crew",   "subtitle": "Active Hold",    "bg_color": "#16160F", "dark_bg": true } },
      { "type": "card", "settings": { "name": "Kids",   "subtitle": "Lil Steps",      "bg_color": "#F2EBDF" } }
    ]
  }]
}
{% endschema %}
