{{ 'gripfeet-design.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<section class="gf-wrap gf-section">
  <div class="gf-section-head">
    <div class="gf-section-head__left">
      <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="gf-h-section">
        {{ section.settings.heading }}
        {%- if section.settings.heading_italic != blank -%}
          <em class="gf-italic">{{ section.settings.heading_italic }}</em>
        {%- endif -%}
      </h2>
    </div>
    <div class="gf-section-head__right">
      {%- if section.settings.all_label != blank -%}
        <a href="{{ section.settings.all_link }}" class="gf-btn--link">
          {{ section.settings.all_label }}
          <svg class="gf-arrow-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="gf-cat-grid">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link }}"
        class="gf-cat-card gf-cat-card--span-{{ block.settings.span }}"
        {{ block.shopify_attributes }}
      >
        <div class="gf-cat-card__img-wrap">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
              sizes="(max-width: 560px) 100vw, (max-width: 960px) 50vw, {{ block.settings.span | times: 100 | divided_by: 12 }}vw"
              alt="{{ block.settings.image.alt | default: block.settings.name }}"
              width="800" height="1000"
              loading="lazy"
            >
          {%- else -%}
            <div class="gf-ph{% if block.settings.dark_ph %} gf-ph--dark{% endif %}" style="aspect-ratio:4/5">
              <span class="gf-ph__label">[ {{ block.settings.cuff }} · {{ block.settings.name }} ]</span>
              <span class="gf-ph__corner">GF · {{ block.settings.code }}</span>
            </div>
          {%- endif -%}
          {%- if block.settings.badge != blank -%}
            <span class="gf-cat-card__badge{% if block.settings.dark_badge %} gf-cat-card__badge--dark{% endif %}">{{ block.settings.badge }}</span>
          {%- endif -%}
        </div>

        <div class="gf-cat-card__meta">
          <div>
            <div class="gf-cat-card__name">
              <small>{{ block.settings.code }} · {{ block.settings.cuff }}</small>
              {{ block.settings.name }}
            </div>
            <p class="gf-cat-card__desc">{{ block.settings.desc }}</p>
            <span class="gf-cat-card__pack">{{ block.settings.pack }}</span>
          </div>
          <span class="gf-cat-card__arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Category Grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow",        "label": "Eyebrow",          "default": "02 — Shop the range · By cuff height" },
    { "type": "text", "id": "heading",        "label": "Heading",          "default": "A grip sock" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic",   "default": "for every step." },
    { "type": "text", "id": "all_label",      "label": "See all label",    "default": "All ranges" },
    { "type": "url",  "id": "all_link",       "label": "See all link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Image (4:5 ratio)" },
        { "type": "checkbox",     "id": "dark_ph",    "label": "Dark placeholder",  "default": false },
        { "type": "text",         "id": "code",       "label": "Code (e.g. 01)",    "default": "01" },
        { "type": "text",         "id": "cuff",       "label": "Cuff type",         "default": "Ankle" },
        { "type": "text",         "id": "name",       "label": "Range name",        "default": "Mat Masters" },
        { "type": "text",         "id": "desc",       "label": "Description",       "default": "Comfort-first grip socks for Pilates, yoga, barre & daily studio wear." },
        { "type": "text",         "id": "pack",       "label": "Pack & price note", "default": "Set of 3 Pairs · from ₹699" },
        { "type": "text",         "id": "badge",      "label": "Badge text (optional)" },
        { "type": "checkbox",     "id": "dark_badge", "label": "Dark badge",        "default": false },
        {
          "type": "select",
          "id": "span",
          "label": "Grid columns (12-col base)",
          "options": [
            { "value": "6", "label": "Half (6 cols)" },
            { "value": "4", "label": "Third (4 cols)" },
            { "value": "3", "label": "Quarter (3 cols)" }
          ],
          "default": "6"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Gripfeet — Category Grid",
    "blocks": [
      { "type": "category", "settings": { "code": "01", "cuff": "Ankle",  "name": "Mat Masters",    "desc": "Comfort-first grip socks for Pilates, yoga, barre & daily studio wear.",           "pack": "Set of 3 Pairs · from ₹699", "span": "6", "badge": "Bestseller" } },
      { "type": "category", "settings": { "code": "02", "cuff": "Crew",   "name": "Active Hold",    "desc": "Performance grip for movement & training. Football, gym, run.",                    "pack": "Set of 2 Pairs · from ₹699", "span": "6", "dark_ph": true } },
      { "type": "category", "settings": { "code": "03", "cuff": "Loafer", "name": "Invisible Grip", "desc": "Invisible comfort with secure all-day grip. Disappears under loafers & sneakers.",  "pack": "Set of 3 Pairs · from ₹599", "span": "4" } },
      { "type": "category", "settings": { "code": "04", "cuff": "Kids",   "name": "Lil Steps",      "desc": "Safe grip socks for little everyday adventures. Ages 0–5.",                        "pack": "Set of 3 Pairs · from ₹399", "span": "4" } },
      { "type": "category", "settings": { "code": "05", "cuff": "Journal","name": "On The Mat",     "desc": "Stories from the studio, hardwood mornings, long flights and slow Sundays.",        "pack": "Editorial · Updated weekly",  "span": "4", "badge": "Coming Soon", "dark_ph": true, "dark_badge": true } }
    ]
  }]
}
{% endschema %}
