<style>
  .height-card .frame { position: relative; }
  .height-card .cat-img, .height-card .cat-img-hover {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center; display: block;
  }
  .height-card .cat-img { transition: transform .55s var(--ease-out); }
  .height-card:hover .cat-img { transform: scale(1.04); }
  .height-card .cat-img-hover { opacity: 0; transition: opacity .45s var(--ease); }
  .height-card:hover .cat-img-hover { opacity: 1; }
</style>

<section class="wrap section" id="shop">
  <div class="section-head center">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="height-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == "catcard" -%}
        <a href="{{ block.settings.link }}" class="height-card" {{ block.shopify_attributes }}>
          <div class="frame">
            {%- if block.settings.badge != blank -%}
              <span class="badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- comment -%} Resolve default (A) + hover (B): editor image_picker overrides, else the approved per-range asset {%- endcomment -%}
            {%- assign catn = block.settings.name | downcase -%}
            {%- assign asset_a = '' -%}
            {%- assign asset_b = '' -%}
            {%- if catn contains 'ankle' -%}{%- assign asset_a = 'gf-cat-ankle.jpg' -%}{%- assign asset_b = 'gf-cat-ankle-hover.jpg' -%}
            {%- elsif catn contains 'crew' -%}{%- assign asset_a = 'gf-cat-crew.jpg' -%}{%- assign asset_b = 'gf-cat-crew-hover.jpg' -%}
            {%- elsif catn contains 'loafer' -%}{%- assign asset_a = 'gf-cat-loafer.jpg' -%}{%- assign asset_b = 'gf-cat-loafer-hover.jpg' -%}
            {%- elsif catn contains 'kid' -%}{%- assign asset_a = 'gf-cat-kids.jpg' -%}{%- assign asset_b = 'gf-cat-kids-hover.jpg' -%}
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img class="cat-img" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name }} · {{ block.settings.subtitle }}" width="900" height="675" loading="lazy">
              {%- if block.settings.image_hover != blank -%}
                <img class="cat-img-hover" src="{{ block.settings.image_hover | image_url: width: 900 }}" alt="" width="900" height="675" loading="lazy" aria-hidden="true">
              {%- endif -%}
            {%- elsif asset_a != '' -%}
              <img class="cat-img" src="{{ asset_a | asset_url }}" alt="{{ block.settings.name }} · {{ block.settings.subtitle }}" width="1400" height="1046" loading="lazy">
              {%- if asset_b != '' -%}
                <img class="cat-img-hover" src="{{ asset_b | asset_url }}" alt="" width="1400" height="1046" loading="lazy" aria-hidden="true">
              {%- endif -%}
            {%- else -%}
              <div class="ph" style="width:100%;height:100%;background:{{ block.settings.bg_color }}">
                <span class="ph-label">{{ block.settings.name }}</span>
                <span class="ph-corner">GF</span>
              </div>
            {%- endif -%}
          </div>
          <div class="label">
            <div class="n">
              <small>{{ block.settings.subtitle }}</small>
              {{ block.settings.name }}
            </div>
            <span class="go">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GF Category Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By cuff height" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Height" }
  ],
  "blocks": [
    {
      "type": "catcard",
      "name": "Category card",
      "settings": [
        { "type": "text",         "id": "name",     "label": "Name",     "default": "Ankle" },
        { "type": "text",         "id": "subtitle", "label": "Subtitle", "default": "Mat Masters" },
        { "type": "text",         "id": "badge",    "label": "Badge",    "default": "New" },
        { "type": "url",          "id": "link",     "label": "Link" },
        { "type": "image_picker", "id": "image",       "label": "Image" },
        { "type": "image_picker", "id": "image_hover", "label": "Hover image (optional)", "info": "Shown on hover, e.g. the sock on-foot or a lifestyle shot." },
        { "type": "color",        "id": "bg_color",    "label": "Background", "default": "#F3F0E8" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "GF Category Grid",
    "blocks": [
      { "type": "catcard", "settings": { "name": "Loafer",  "subtitle": "Invisible Grip", "bg_color": "#EFE9DD" } },
      { "type": "catcard", "settings": { "name": "Ankle",   "subtitle": "Mat Masters",    "bg_color": "#F3F0E8", "badge": "Bestseller" } },
      { "type": "catcard", "settings": { "name": "Crew",    "subtitle": "Active Hold",    "bg_color": "#16160F" } },
      { "type": "catcard", "settings": { "name": "Kids",    "subtitle": "Lil Steps",      "bg_color": "#F2EBDF" } }
    ]
  }]
}
{% endschema %}
