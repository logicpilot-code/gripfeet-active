<section class="wrap section" id="shop">
  <div class="section-head center">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="height-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == "catcard" -%}
        <a href="{{ block.settings.link }}" class="height-card" {{ block.shopify_attributes }}>
          <div class="frame">
            {%- if block.settings.badge != blank -%}
              <span class="badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.name }}"
                width="800" height="800"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;display:block"
              >
            {%- else -%}
              {%- assign _stock_ids = '1544367567-0f2fcb009e0b,1542291026-7eec264c27ff,1517838277536-f5f99be501cd,1571019614242-c5c5dee9f50b,1503454537195-1dcabb73ffb9,1506002078363-b6a2ac8b0481' | split: ',' -%}
              {%- assign _sid = _stock_ids[forloop.index0] | default: _stock_ids[0] -%}
              <img
                src="https://images.unsplash.com/photo-{{ _sid }}?w=800&auto=format&fit=crop&q=80"
                alt="{{ block.settings.name }}"
                width="800" height="800"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;display:block"
              >
            {%- endif -%}
          </div>
          <div class="label">
            <div class="n">
              <small>{{ block.settings.subtitle }}</small>
              {{ block.settings.name }}
            </div>
            <span class="go">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GF Category Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By cuff height" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Height" }
  ],
  "blocks": [
    {
      "type": "catcard",
      "name": "Category card",
      "settings": [
        { "type": "text",         "id": "name",     "label": "Name",     "default": "Ankle" },
        { "type": "text",         "id": "subtitle", "label": "Subtitle", "default": "Mat Masters" },
        { "type": "text",         "id": "badge",    "label": "Badge",    "default": "New" },
        { "type": "url",          "id": "link",     "label": "Link" },
        { "type": "image_picker", "id": "image",    "label": "Image" },
        { "type": "color",        "id": "bg_color", "label": "Background", "default": "#F3F0E8" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "GF Category Grid",
    "blocks": [
      { "type": "catcard", "settings": { "name": "Loafer",  "subtitle": "Invisible Grip", "bg_color": "#EFE9DD" } },
      { "type": "catcard", "settings": { "name": "Ankle",   "subtitle": "Mat Masters",    "bg_color": "#F3F0E8", "badge": "Bestseller" } },
      { "type": "catcard", "settings": { "name": "Crew",    "subtitle": "Active Hold",    "bg_color": "#16160F" } },
      { "type": "catcard", "settings": { "name": "Kids",    "subtitle": "Lil Steps",      "bg_color": "#F2EBDF" } }
    ]
  }]
}
{% endschema %}
