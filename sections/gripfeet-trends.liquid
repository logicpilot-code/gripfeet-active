<section class="wrap section" id="trends">
  <div class="section-head">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ section.settings.heading }}</h2>
    </div>
    <div class="right">
      <a href="{{ section.settings.all_link }}" class="btn-link">
        All ranges
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <div class="trends-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == "card" -%}
        <a href="{{ block.settings.link }}" class="trend-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title }}" width="900" height="1100" loading="lazy" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">
          {%- else -%}
            {%- assign tt = block.settings.title | downcase -%}
            {%- assign trimg = '' -%}
            {%- if tt contains 'mat' -%}{%- assign trimg = 'gf-trend-ankle.jpg' -%}
            {%- elsif tt contains 'active' -%}{%- assign trimg = 'gf-trend-crew.jpg' -%}
            {%- elsif tt contains 'lil' or tt contains 'kid' or tt contains 'step' -%}{%- assign trimg = 'gf-trend-kids.jpg' -%}
            {%- endif -%}
            {%- if trimg != '' -%}
              <div class="ph has-photo ph-dark" style="position:absolute;inset:0;width:100%;height:100%">
                <img class="ph-img" src="{{ trimg | asset_url }}" alt="{{ block.settings.title }} · lifestyle" width="1200" height="1500" loading="lazy" style="object-position:center 42%">
              </div>
            {%- else -%}
              <div class="ph ph-photo" style="position:absolute;inset:0;width:100%;height:100%;background:{{ block.settings.bg_color | default: '#191919' }}">
                <span class="ph-label">{{ block.settings.title }} · lifestyle editorial</span>
                <span class="ph-corner">GF</span>
              </div>
            {%- endif -%}
          {%- endif -%}
          <div class="scrim"></div>
          <div class="tinfo">
            <div class="te">{{ block.settings.eyebrow }}</div>
            <div class="tt">{{ block.settings.title }}</div>
            <span class="tgo">
              Explore
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Gripfeet — Shop Trends",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",  "default": "Worn everywhere" },
    { "type": "text", "id": "heading",  "label": "Heading",  "default": "Shop the ranges." },
    { "type": "url",  "id": "all_link", "label": "All link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Trend card",
      "settings": [
        { "type": "text",         "id": "eyebrow",  "label": "Eyebrow",     "default": "Studio & Mat" },
        { "type": "text",         "id": "title",    "label": "Title",       "default": "Mat Masters" },
        { "type": "url",          "id": "link",     "label": "Link" },
        { "type": "image_picker", "id": "image",    "label": "Image" },
        { "type": "color",        "id": "bg_color", "label": "Placeholder bg", "default": "#191919" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{
    "name": "Gripfeet — Shop Trends",
    "blocks": [
      { "type": "card", "settings": { "eyebrow": "Studio & Mat",         "title": "Mat Masters",  "bg_color": "#1e2017" } },
      { "type": "card", "settings": { "eyebrow": "Movement & Training",  "title": "Active Hold",  "bg_color": "#191919" } },
      { "type": "card", "settings": { "eyebrow": "Little Adventures",    "title": "Lil Steps",    "bg_color": "#20171c" } }
    ]
  }]
}
{% endschema %}