{%- comment -%} Infinite editorial marquee band (reuses gf-belt from gripfeet-motion.css) {%- endcomment -%}
{%- assign items = section.settings.text | split: '·' -%}
{%- capture band -%}
  {%- for item in items -%}
    {%- assign t = item | strip -%}
    {%- unless t == blank -%}<span class="gf-band-item">{{ t }}</span><span class="gf-band-item gf-band-sep">·</span>{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if band != blank -%}
  <div class="gf-band gf-mq gf-mq--mask{% if section.settings.dark %} gf-band--ink{% endif %}" aria-hidden="true">
    <div class="gf-mq__track" style="--mq-dur: {{ section.settings.speed | default: 40 }}s; --mq-dir: {% if section.settings.reverse %}reverse{% else %}normal{% endif %}">{{ band }}{{ band }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "GF Editorial Marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Marquee items (separate with ·)", "default": "Pilates · Yoga · Barre · Travel · Home · Hardwood · Marble · Studio · Football · Sleep" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    { "type": "checkbox", "id": "reverse", "label": "Scroll right-to-left", "default": false },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds per loop)", "min": 20, "max": 80, "step": 2, "unit": "s", "default": 40 }
  ],
  "presets": [{ "name": "GF Editorial Marquee" }]
}
{% endschema %}
