{{ 'gripfeet-sections.css' | asset_url | stylesheet_tag }}
<div class="gf-announce">
  <div class="gf-announce__inner">
    <span></span>
    <div class="gf-announce__msg">
      {%- for block in section.blocks -%}
        {%- if block.type == 'message' -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- unless forloop.last -%}<span class="sep">&nbsp;·&nbsp;</span>{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <span></span>
  </div>
</div>

{% schema %}
{
  "name": "GF Announcement Bar",
  "tag": "section",
  "settings": [],
  "blocks": [
    { "type": "message", "name": "Message",
      "settings": [{ "type": "text", "id": "text", "label": "Message", "default": "Free shipping worldwide on orders over ₹999" }]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "GF Announcement Bar",
    "blocks": [
      { "type": "message", "settings": { "text": "Launch pricing — up to 39% off · Shop bundles" } },
      { "type": "message", "settings": { "text": "Free shipping worldwide on orders over ₹999" } },
      { "type": "message", "settings": { "text": "Stretch Supima yarn · 100% silicone grip · Made in India" } }
    ]
  }]
}
{% endschema %}
