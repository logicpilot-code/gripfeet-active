{%- comment -%} Infinite-scrolling announcement ticker (reuses gf-belt from gripfeet-motion.css) {%- endcomment -%}
{%- capture annc -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'message' -%}
      <span class="gf-annc-item" {{ block.shopify_attributes }}><span class="gf-annc-dot"></span>{{ block.settings.text }}</span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if annc != blank -%}
  <div class="gf-annc gf-mq gf-mq--mask">
    <div class="gf-mq__track" style="--mq-dur: {{ section.settings.speed | default: 34 }}s">{{ annc }}{{ annc }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "GF Announcement Bar",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds per loop)", "min": 15, "max": 60, "step": 1, "unit": "s", "default": 34 }
  ],
  "blocks": [
    { "type": "message", "name": "Message",
      "settings": [{ "type": "text", "id": "text", "label": "Message", "default": "Free shipping worldwide on orders over ₹999" }]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "GF Announcement Bar",
    "blocks": [
      { "type": "message", "settings": { "text": "Launch pricing, up to 39% off · Shop bundles" } },
      { "type": "message", "settings": { "text": "Free shipping worldwide on orders over ₹999" } },
      { "type": "message", "settings": { "text": "Stretch Supima yarn · 100% silicone grip · Made in India" } }
    ]
  }]
}
{% endschema %}
