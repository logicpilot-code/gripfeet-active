{%- comment -%} CREW · Active Hold — dark technical (lime on near-black) {%- endcomment -%}

<!-- 1 · Spec sheet (dark) -->
<section class="crew-spec">
  <div class="wrap">
    <div class="crew-spec-head">
      <span class="eyebrow"><span class="dot"></span>{{ spec_eyebrow | default: 'The spec sheet' }}</span>
      <h2 class="h-section">{{ spec_heading | default: 'Engineered to hold under load.' }}</h2>
      <p>{{ spec_lead | default: 'Not a lifestyle sock with a logo on it. Every line below is tuned for movement: football pivots, gym sets, hard miles.' }}</p>
    </div>
    <div class="crew-spec-table">
      <div class="csr"><span class="csr-k">Grip pattern</span><span class="csr-v">Full-sole silicone</span><span class="csr-d">100% food-grade, hex-lattice</span></div>
      <div class="csr"><span class="csr-k">Grip density</span><span class="csr-v">High · 4.2 dots/cm²</span><span class="csr-d">Tuned for lateral cuts</span></div>
      <div class="csr"><span class="csr-k">Cushion</span><span class="csr-v">Targeted zones</span><span class="csr-d">Heel pad + forefoot, thin midfoot</span></div>
      <div class="csr"><span class="csr-k">Cuff</span><span class="csr-v">Ribbed crew · 18cm</span><span class="csr-d">Stay-up compression band</span></div>
      <div class="csr"><span class="csr-k">Yarn</span><span class="csr-v">Stretch Supima blend</span><span class="csr-d">72% Supima / 24% nylon / 4% elastane</span></div>
      <div class="csr"><span class="csr-k">Moisture</span><span class="csr-v">Channelled knit</span><span class="csr-d">Pulls sweat off the skin, dries fast</span></div>
    </div>
  </div>
</section>

<!-- 2 · Grip zones -->
<section class="wrap section crew-zones">
  <div class="crew-zones-vis" id="crew-zones-vis">
    <div class="ph ph-dark" style="background:#16160F;width:100%;height:100%">
      <span class="ph-label">Grip-zone map · sole detail · annotated</span>
      <span class="ph-corner">GF-CRW · ZONES</span>
    </div>
    <button type="button" class="crew-pin pin-0 on" data-z="0" aria-label="Heel lock">1</button>
    <button type="button" class="crew-pin pin-1" data-z="1" aria-label="Lateral grip">2</button>
    <button type="button" class="crew-pin pin-2" data-z="2" aria-label="Forefoot drive">3</button>
    <button type="button" class="crew-pin pin-3" data-z="3" aria-label="Toe spring">4</button>
  </div>
  <div class="crew-zones-side">
    <span class="eyebrow"><span class="dot"></span>{{ zones_eyebrow | default: 'Four working zones' }}</span>
    <h2 class="h-sub" style="margin-top:12px">{{ zones_heading | default: 'Grip where it earns it.' }}</h2>
    <div class="crew-zone-list" id="crew-zone-list">
      <button type="button" class="czl on" data-z="0"><span class="czl-n">01</span><div><strong>Heel lock</strong><p>Compression cradle stops heel lift inside the shoe.</p></div></button>
      <button type="button" class="czl" data-z="1"><span class="czl-n">02</span><div><strong>Lateral grip</strong><p>Dense silicone bands resist side-to-side slide on cuts.</p></div></button>
      <button type="button" class="czl" data-z="2"><span class="czl-n">03</span><div><strong>Forefoot drive</strong><p>Reinforced pad for push-off and sprint starts.</p></div></button>
      <button type="button" class="czl" data-z="3"><span class="czl-n">04</span><div><strong>Toe spring</strong><p>Seamless toe box, no rub on repeated impact.</p></div></button>
    </div>
  </div>
</section>

<!-- 3 · Sport use -->
<section class="crew-sport">
  <div class="wrap">
    <div class="crew-sport-grid">
      <div class="crew-sport-left">
        <span class="eyebrow"><span class="dot"></span>{{ sport_eyebrow | default: 'Pick your arena' }}</span>
        <h2 class="h-section">{{ sport_heading | default: 'Tuned for how you train.' }}</h2>
        <div class="crew-sport-tabs" id="crew-sport-tabs">
          <button type="button" class="crew-tab on" data-label="FOOTBALL" data-feat="Stud-pressure heel pad|Lateral grip for cuts|Stay-up crew cuff">Football</button>
          <button type="button" class="crew-tab" data-label="GYM &amp; LIFTING" data-feat="Flat, stable footbed|Grip for barefoot lifts|Breathable midfoot">Gym &amp; lifting</button>
          <button type="button" class="crew-tab" data-label="RUNNING" data-feat="Channelled moisture knit|Seamless toe box|Light forefoot cushion">Running</button>
          <button type="button" class="crew-tab" data-label="COURT" data-feat="Court-shaped cuff|Anti-roll lateral bands|Quick-dry yarn">Court</button>
        </div>
      </div>
      <div class="crew-sport-right">
        <div class="ph ph-dark" style="background:#1b1b14"><span class="ph-corner" id="crew-sport-label">FOOTBALL</span></div>
        <ul class="crew-feat" id="crew-sport-feat">
          <li><span class="cf-tick"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Stud-pressure heel pad</li>
          <li><span class="cf-tick"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Lateral grip for cuts</li>
          <li><span class="cf-tick"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Stay-up crew cuff</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 4 · Stress test (dark stats) -->
<section class="crew-stress">
  <div class="wrap">
    <div class="crew-stress-head">
      <span class="eyebrow"><span class="dot"></span>{{ stress_eyebrow | default: 'Lab + locker room' }}</span>
      <h2 class="h-sub">{{ stress_heading | default: 'Stress-tested, then worn for a season.' }}</h2>
    </div>
    <div class="crew-stat-row">
      <div class="crew-stat"><span class="cs-v">120k</span><span class="cs-l">Flex cycles tested</span></div>
      <div class="crew-stat"><span class="cs-v">50+</span><span class="cs-l">Wash cycles, grip intact</span></div>
      <div class="crew-stat"><span class="cs-v">1.6×</span><span class="cs-l">Lateral grip vs. cotton sock</span></div>
      <div class="crew-stat"><span class="cs-v">0</span><span class="cs-l">Slip-downs reported</span></div>
    </div>
  </div>
</section>

<script>
(function () {
  // grip zones — sync pins + list
  var vis = document.getElementById("crew-zones-vis");
  var list = document.getElementById("crew-zone-list");
  function selectZone(z) {
    if (vis) vis.querySelectorAll(".crew-pin").forEach(function (p) { p.classList.toggle("on", p.dataset.z === z); });
    if (list) list.querySelectorAll(".czl").forEach(function (l) { l.classList.toggle("on", l.dataset.z === z); });
  }
  [vis, list].forEach(function (root) {
    if (!root) return;
    root.querySelectorAll("[data-z]").forEach(function (el) {
      el.addEventListener("click", function () { selectZone(el.dataset.z); });
    });
  });

  // sport tabs
  var tabs = document.getElementById("crew-sport-tabs");
  var label = document.getElementById("crew-sport-label");
  var feat = document.getElementById("crew-sport-feat");
  var tick = '<span class="cf-tick"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>';
  if (tabs) tabs.querySelectorAll(".crew-tab").forEach(function (t) {
    t.addEventListener("click", function () {
      tabs.querySelectorAll(".crew-tab").forEach(function (x) { x.classList.remove("on"); });
      t.classList.add("on");
      if (label) label.innerHTML = t.dataset.label;
      if (feat) feat.innerHTML = t.dataset.feat.split("|").map(function (f) { return "<li>" + tick + f + "</li>"; }).join("");
    });
  });
})();
</script>
