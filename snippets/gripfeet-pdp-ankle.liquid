{%- comment -%} ANKLE · Mat Masters — calm studio editorial (sage) {%- endcomment -%}

<!-- 1 · Surfaces -->
<section class="wrap section ank-surf">
  <div class="ank-surf-head">
    <span class="eyebrow"><span class="dot"></span>{{ surf_eyebrow | default: 'Grip you can trust' }}</span>
    <h2 class="h-section">{{ surf_heading | default: 'Sure-footed on every studio surface.' }}</h2>
  </div>
  <div class="ank-surf-body">
    <div class="ank-surf-vis">
      <div class="ph" style="background:#EAE7DD;width:100%;height:100%">
        <span class="ph-label" id="ank-surf-label">Reformer · grip in motion · barefoot studio</span>
        <span class="ph-corner">SURFACE</span>
      </div>
      <span class="ank-grip-chip" id="ank-surf-chip">Full-sole hold</span>
    </div>
    <div class="ank-surf-side" id="ank-surf-rows">
      <button type="button" class="ank-surf-row on" data-name="Reformer" data-grip="Full-sole hold">
        <span class="asr-n">Reformer</span><span class="asr-note">Locks to the carriage on the deepest stretch — no toe-curl gripping.</span><span class="asr-go"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></span>
      </button>
      <button type="button" class="ank-surf-row" data-name="Hardwood" data-grip="Zero slide">
        <span class="asr-n">Hardwood</span><span class="asr-note">Warm, quiet traction on studio floors and home boards alike.</span><span class="asr-go"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></span>
      </button>
      <button type="button" class="ank-surf-row" data-name="Marble" data-grip="Wet-safe">
        <span class="asr-n">Marble</span><span class="asr-note">Confident footing on the slickest polished stone, wet or dry.</span><span class="asr-go"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></span>
      </button>
      <button type="button" class="ank-surf-row" data-name="Yoga mat" data-grip="Soft anchor">
        <span class="asr-n">Yoga mat</span><span class="asr-note">Settles into the mat for balance work without bunching underfoot.</span><span class="asr-go"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></span>
      </button>
    </div>
  </div>
</section>

<!-- 2 · Practice -->
<section class="section band ank-practice">
  <div class="wrap">
    <div class="section-head center">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ prac_eyebrow | default: 'Made for your mat' }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ prac_heading | default: "What's your practice?" }}</h2>
      </div>
    </div>
    <div class="ank-prac-chips" id="ank-prac-chips">
      <button type="button" class="ank-chip on" data-cushion="Light cushion" data-why="Closer feel for reformer &amp; mat precision.">Pilates</button>
      <button type="button" class="ank-chip" data-cushion="Light cushion" data-why="Thin footbed for balance and floor poses.">Yoga</button>
      <button type="button" class="ank-chip" data-cushion="Mid cushion" data-why="A touch more padding for the ball of the foot.">Barre</button>
      <button type="button" class="ank-chip" data-cushion="Mid cushion" data-why="All-day softness for hardwood and hotel floors.">Home &amp; travel</button>
    </div>
    <div class="ank-prac-card">
      <div class="apc-vis">
        <div class="ph{% if product.featured_image %} has-photo{% endif %}" style="background:#E7ECE0;width:100%;height:100%">
          {%- if product.featured_image -%}<img class="ph-img" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" height="800" loading="lazy">{%- else -%}<span class="ph-corner">{{ product.title | upcase | truncate: 10, "" }}</span>{%- endif -%}
        </div>
      </div>
      <div class="apc-body">
        <span class="apc-rec">Made for this</span>
        <h3>{{ product.title }}</h3>
        <div class="apc-meta"><span class="apc-pill" id="ank-prac-cushion">Light cushion</span><span class="apc-pill ghost">Full silicone sole</span></div>
        <p id="ank-prac-why">Closer feel for reformer &amp; mat precision. Comfort-first Supima with a full silicone sole — the wardrobe trio you'll actually keep wearing.</p>
        <a class="btn btn-primary btn-sm" href="#pdp-gallery">Choose your pack <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- 3 · Tonal colour story -->
<section class="wrap section tight ank-story">
  <div class="ank-story-head">
    <h2 class="h-sub">{{ story_heading | default: 'A tonal story, knit to be worn together.' }}</h2>
    <p class="muted">{{ story_lead | default: 'Three quiet tones that move from mat to street without trying.' }}</p>
  </div>
  <div class="ank-story-flat">
    {%- assign color_opt = nil -%}
    {%- for opt in product.options_with_values -%}
      {%- assign on = opt.name | downcase -%}
      {%- if on contains 'colour' or on contains 'color' or on contains 'style' -%}{%- assign color_opt = opt -%}{%- endif -%}
    {%- endfor -%}
    {%- if color_opt -%}
      {%- for val in color_opt.values limit: 3 -%}
        <div class="ank-tone">
          <div class="at-swatch" style="background:{% if val.swatch.color %}{{ val.swatch.color }}{% else %}var(--accent-soft){% endif %}"></div>
          <span class="at-name">{{ val }}</span>
          <span class="at-no">0{{ forloop.index }}</span>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- assign tones = 'Warm Beige,Sage,Lavender' | split: ',' -%}
      {%- for t in tones -%}
        <div class="ank-tone"><div class="at-swatch" style="background:var(--accent-soft)"></div><span class="at-name">{{ t }}</span><span class="at-no">0{{ forloop.index }}</span></div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<!-- 4 · Instructors (rotating quote) -->
<section class="wrap section ank-instr">
  <div class="ank-instr-card">
    <div class="aic-portrait"><div class="ph" style="background:#E7ECE0;width:100%;height:100%"><span class="ph-corner">INSTRUCTOR</span></div></div>
    <div class="aic-body">
      <span class="eyebrow"><span class="dot"></span>{{ instr_eyebrow | default: 'From the studio floor' }}</span>
      <blockquote id="ank-quote">“I put my whole studio in these. They're the first grip sock that doesn't feel like a compromise.”</blockquote>
      <div class="aic-who"><strong id="ank-quote-n">Megha R.</strong><span id="ank-quote-r">Reformer Pilates · Hyderabad</span></div>
      <div class="aic-dots" id="ank-dots">
        <button type="button" class="on" data-i="0" aria-label="Quote 1"></button>
        <button type="button" data-i="1" aria-label="Quote 2"></button>
        <button type="button" data-i="2" aria-label="Quote 3"></button>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  // surface switcher
  var rows = document.getElementById("ank-surf-rows");
  var label = document.getElementById("ank-surf-label");
  var chip = document.getElementById("ank-surf-chip");
  if (rows) rows.querySelectorAll(".ank-surf-row").forEach(function (r) {
    r.addEventListener("click", function () {
      rows.querySelectorAll(".ank-surf-row").forEach(function (x) { x.classList.remove("on"); });
      r.classList.add("on");
      if (label) label.textContent = r.dataset.name + " · grip in motion · barefoot studio";
      if (chip) chip.textContent = r.dataset.grip;
    });
  });

  // practice chips
  var chips = document.getElementById("ank-prac-chips");
  var cushion = document.getElementById("ank-prac-cushion");
  var why = document.getElementById("ank-prac-why");
  if (chips) chips.querySelectorAll(".ank-chip").forEach(function (c) {
    c.addEventListener("click", function () {
      chips.querySelectorAll(".ank-chip").forEach(function (x) { x.classList.remove("on"); });
      c.classList.add("on");
      if (cushion) cushion.textContent = c.dataset.cushion;
      if (why) why.innerHTML = c.dataset.why + " Comfort-first Supima with a full silicone sole — the wardrobe trio you'll actually keep wearing.";
    });
  });

  // instructor rotation
  var Q = [
    { q: "I put my whole studio in these. They're the first grip sock that doesn't feel like a compromise.", n: "Megha R.", r: "Reformer Pilates · Hyderabad" },
    { q: "The Supima holds up to twelve classes a week and the grip never wears flat. That's unusual.", n: "Tara D.", r: "Yoga & barre · Goa" },
    { q: "My clients ask what they are every single week. Quietly the best part of my kit.", n: "Sana K.", r: "Mat Pilates · Mumbai" }
  ];
  var quote = document.getElementById("ank-quote");
  var qn = document.getElementById("ank-quote-n");
  var qr = document.getElementById("ank-quote-r");
  var dots = document.getElementById("ank-dots");
  var i = 0, timer;
  function show(n) {
    i = n;
    if (quote) quote.textContent = "“" + Q[i].q + "”";
    if (qn) qn.textContent = Q[i].n;
    if (qr) qr.textContent = Q[i].r;
    if (dots) dots.querySelectorAll("button").forEach(function (b, j) { b.classList.toggle("on", j === i); });
  }
  function loop() { timer = setInterval(function () { show((i + 1) % Q.length); }, 5200); }
  if (dots) dots.querySelectorAll("button").forEach(function (b) {
    b.addEventListener("click", function () { clearInterval(timer); show(parseInt(b.dataset.i, 10)); loop(); });
  });
  loop();
})();
</script>
