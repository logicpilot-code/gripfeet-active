{%- comment -%} KIDS · Lil Steps — playful & reassuring (coral) {%- endcomment -%}

<!-- 1 · Fit finder (age slider) -->
<section class="wrap section kid-finder">
  <div class="kid-finder-card">
    <div class="kid-finder-copy">
      <span class="eyebrow"><span class="dot"></span>{{ finder_eyebrow | default: 'Fit finder' }}</span>
      <h2 class="h-section" style="margin-top:12px">{{ finder_heading | default: 'What size are their little feet?' }}</h2>
      <p>Slide to their age, we'll match the size and the pack. Between sizes? Size up; the stretchy cuff grows with them.</p>
    </div>
    <div class="kid-finder-tool">
      <div class="kft-age" id="kft-age">2 yrs</div>
      <input class="kid-slider" id="kft-slider" type="range" min="0" max="60" step="1" value="24">
      <div class="kft-scale"><span>0</span><span>1 yr</span><span>2</span><span>3</span><span>4</span><span>5 yr</span></div>
      <div class="kft-result">
        <div class="kft-sz" id="kft-sz">S</div>
        <div class="kft-meta"><strong id="kft-szlabel">Size S</strong><span id="kft-szmeta">11–14 cm · EU 20–24</span></div>
        <a class="btn btn-primary btn-sm" href="#pdp-gallery" id="kft-shop">Choose size S <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- 2 · Safety story -->
<section class="kid-safety">
  <div class="wrap">
    <div class="section-head center">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ safety_eyebrow | default: "Built for parents' peace of mind" }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ safety_heading | default: 'Safe steps, every floor.' }}</h2>
      </div>
    </div>
    <div class="kid-safety-grid">
      <div class="kid-safe-card">
        <span class="ksc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="17" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="17" cy="12" r="1"/><circle cx="7" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="17" cy="17" r="1"/></svg></span>
        <h3>Won't slip on slick floors</h3>
        <p>Full silicone sole grips marble, tile and hardwood, the floors toddlers love to run on.</p>
      </div>
      <div class="kid-safe-card">
        <span class="ksc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19c4-4 8-6 14-14"/></svg></span>
        <h3>Gentle, safe materials</h3>
        <p>Soft Supima knit with skin-friendly, non-toxic dyes. Nothing scratchy near little skin.</p>
      </div>
      <div class="kid-safe-card">
        <span class="ksc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
        <h3>Stays up, stays on</h3>
        <p>Stretchy ribbed cuff holds the ankle, no more socks sliding off mid-play.</p>
      </div>
    </div>
  </div>
</section>

<!-- 3 · Room to grow -->
<section class="wrap section kid-grow">
  <div class="kid-grow-head">
    <h2 class="h-sub">{{ grow_heading | default: 'Knit to grow with them.' }}</h2>
    <p class="muted">{{ grow_lead | default: "Stretchy Supima and a forgiving cuff mean each size lasts longer than you'd expect." }}</p>
  </div>
  <div class="kid-grow-track">
    <div class="kid-grow-step"><span class="kgs-dot">1</span><span class="kgs-age">0–1 yr</span><strong>First crawls</strong><p>Soft, seamless toe for tiny feet finding their footing.</p></div>
    <div class="kid-grow-step"><span class="kgs-dot">2</span><span class="kgs-age">1–3 yr</span><strong>First runs</strong><p>Grip kicks in for wobbly sprints across the living room.</p></div>
    <div class="kid-grow-step"><span class="kgs-dot">3</span><span class="kgs-age">3–5 yr</span><strong>Full speed</strong><p>Stay-up cuff and full sole keep up with everything.</p></div>
  </div>
</section>

<!-- 4 · Parent reviews -->
<section class="kid-parents">
  <div class="wrap">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>{{ parents_eyebrow | default: 'From the parents' }}</span>
        <h2 class="h-section" style="margin-top:14px">{{ parents_heading | default: 'Tested by tiny feet.' }}</h2>
      </div>
    </div>
    <div class="kid-parents-grid">
      <div class="kid-pcard"><span class="kpc-stars stars-svg">★★★★★</span><p>“My toddler runs across our marble like it's a track. Finally a grip sock that fits and doesn't slide off.”</p><div class="kpc-who"><span class="kpc-av"></span><div><strong>Priya</strong><span>mum of Ishaan, 2</span></div></div></div>
      <div class="kid-pcard"><span class="kpc-stars stars-svg">★★★★★</span><p>“The pastels are adorable and they've survived every single wash. Buying the next size up already.”</p><div class="kpc-who"><span class="kpc-av"></span><div><strong>Neha</strong><span>mum of twins, 3</span></div></div></div>
      <div class="kid-pcard"><span class="kpc-stars stars-svg">★★★★★</span><p>“Stays put on my wriggly one-year-old. That alone is worth it.”</p><div class="kpc-who"><span class="kpc-av"></span><div><strong>Arjun</strong><span>dad of Myra, 1</span></div></div></div>
    </div>
  </div>
</section>

<script>
(function () {
  var slider = document.getElementById("kft-slider");
  if (!slider) return;
  var ageEl = document.getElementById("kft-age");
  var szEl = document.getElementById("kft-sz");
  var szLabel = document.getElementById("kft-szlabel");
  var szMeta = document.getElementById("kft-szmeta");
  var shop = document.getElementById("kft-shop");
  var arrow = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>';

  function sizeFor(m) {
    if (m < 12) return { sz: "XS", foot: "8–11 cm", eu: "EU 16–19" };
    if (m < 36) return { sz: "S", foot: "11–14 cm", eu: "EU 20–24" };
    return { sz: "M", foot: "14–17 cm", eu: "EU 25–29" };
  }
  function update() {
    var m = parseInt(slider.value, 10);
    var yrs = Math.floor(m / 12), mo = m % 12;
    var ageLabel = m < 12 ? (m + " months") : (yrs + " yr" + (yrs > 1 ? "s" : "") + (mo ? " " + mo + " mo" : ""));
    var r = sizeFor(m);
    if (ageEl) ageEl.textContent = ageLabel;
    if (szEl) szEl.textContent = r.sz;
    if (szLabel) szLabel.textContent = "Size " + r.sz;
    if (szMeta) szMeta.textContent = r.foot + " · " + r.eu;
    if (shop) shop.innerHTML = "Choose size " + r.sz + " " + arrow;
  }
  slider.addEventListener("input", update);
  update();
})();
</script>
