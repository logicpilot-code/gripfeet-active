{%- comment -%} LOAFER · Invisible Grip — quiet luxe (clay) {%- endcomment -%}

<!-- 1 · Disappears under -->
<section class="wrap section lof-under">
  <div class="lof-under-head">
    <span class="eyebrow"><span class="dot"></span>{{ under_eyebrow | default: 'The point of a no-show' }}</span>
    <h2 class="h-section">{{ under_heading | default: 'Seen by no one. Felt all day.' }}</h2>
  </div>
  <div class="lof-under-grid">
    <div class="lof-shoe"><div class="ph" style="background:#EEE9E0;aspect-ratio:1;border-radius:18px;margin-bottom:18px"><span class="ph-corner">01</span></div><h4>Loafers</h4><p>Sits below the topline. Bare-ankle look, zero slip-down.</p></div>
    <div class="lof-shoe"><div class="ph" style="background:#EEE9E0;aspect-ratio:1;border-radius:18px;margin-bottom:18px"><span class="ph-corner">02</span></div><h4>Derbies</h4><p>Invisible under a tailored shoe, all-day heel hold.</p></div>
    <div class="lof-shoe"><div class="ph" style="background:#EEE9E0;aspect-ratio:1;border-radius:18px;margin-bottom:18px"><span class="ph-corner">03</span></div><h4>Sneakers</h4><p>Low-cut scoop disappears under the collar.</p></div>
    <div class="lof-shoe"><div class="ph" style="background:#EEE9E0;aspect-ratio:1;border-radius:18px;margin-bottom:18px"><span class="ph-corner">04</span></div><h4>Mules</h4><p>Silicone heel band keeps it on with an open back.</p></div>
  </div>
</section>

<!-- 2 · Heel cutaway -->
<section class="lof-cut">
  <div class="wrap lof-cut-inner">
    <div class="lof-cut-vis">
      <div class="ph" style="background:#E9E3D8;width:100%;height:100%">
        <span class="ph-label">Heel cutaway · cross-section · silicone band detail</span>
        <span class="ph-corner">GF-LOF · ANATOMY</span>
      </div>
      <div class="lof-cut-line" id="lof-cut-line" style="top:38%"></div>
    </div>
    <div class="lof-cut-side">
      <span class="eyebrow"><span class="dot"></span>{{ cut_eyebrow | default: 'How it holds' }}</span>
      <h2 class="h-sub" style="margin-top:12px">{{ cut_heading | default: 'The whole trick is one silicone ring.' }}</h2>
      <ol class="lof-parts" id="lof-parts">
        <li data-i="0"><span class="lp-n">01</span><div><strong>Scalloped low-cut</strong><p>Drops below the shoe line so nothing peeks out.</p></div></li>
        <li class="on" data-i="1"><span class="lp-n">02</span><div><strong>Silicone heel band</strong><p>A continuous grip ring — the part that actually stops the slide-down.</p></div></li>
        <li data-i="2"><span class="lp-n">03</span><div><strong>Cushioned heel cup</strong><p>Supima padding where the shoe rubs most.</p></div></li>
        <li data-i="3"><span class="lp-n">04</span><div><strong>Seamless toe</strong><p>Flat-knit toe closure, invisible under thin leather.</p></div></li>
      </ol>
    </div>
  </div>
</section>

<!-- 3 · Shade match -->
<section class="wrap section lof-shade">
  <div class="section-head">
    <div class="left">
      <span class="eyebrow"><span class="dot"></span>{{ shade_eyebrow | default: 'Match to skin' }}</span>
      <h2 class="h-section" style="margin-top:14px">{{ shade_heading | default: 'Find your invisible.' }}</h2>
    </div>
    <div class="right"><span class="muted" style="font-size:13px;max-width:26ch">The closer the tone, the more it vanishes under open shoes.</span></div>
  </div>
  <div class="lof-shade-tool">
    <div class="lof-skin">
      <span class="lof-skin-lbl">Your skin tone</span>
      <div class="lof-skin-row" id="lof-skin-row">
        <button type="button" class="lof-skin-sw" style="background:#F0D9C2" data-name="Fair / light" data-rec="Warm Beige" data-hex="#D9C9B3" aria-label="Fair / light"></button>
        <button type="button" class="lof-skin-sw on" style="background:#D9B492" data-name="Light–medium" data-rec="Warm Beige" data-hex="#D9C9B3" aria-label="Light–medium"></button>
        <button type="button" class="lof-skin-sw" style="background:#B98A63" data-name="Medium / tan" data-rec="Dusty Brown" data-hex="#7A6A57" aria-label="Medium / tan"></button>
        <button type="button" class="lof-skin-sw" style="background:#8A5E3C" data-name="Deep / rich" data-rec="Dusty Brown" data-hex="#7A6A57" aria-label="Deep / rich"></button>
        <button type="button" class="lof-skin-sw" style="background:#5A3A24" data-name="Deepest" data-rec="Dusty Brown" data-hex="#7A6A57" aria-label="Deepest"></button>
      </div>
      <span class="lof-skin-name" id="lof-skin-name">Light–medium</span>
    </div>
    <span class="lof-shade-arrow"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></span>
    <div class="lof-rec">
      <span class="lof-rec-lbl">We'd hide</span>
      <div class="lof-rec-chip"><span class="dot" id="lof-rec-dot" style="background:#D9C9B3"></span><span id="lof-rec-name">Warm Beige</span></div>
      <a class="btn btn-outline btn-sm" href="#pdp-gallery">Shop this pair <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg></a>
    </div>
  </div>
</section>

<!-- 4 · Statement line -->
<section class="lof-line">
  <div class="wrap">
    <p><span class="lead">{{ line_lead | default: 'Looks bare.' }}</span> <span class="rest">{{ line_rest | default: 'Holds tight.' }}</span></p>
    <div class="lof-line-foot">
      <span>Scalloped low-cut</span><span class="div"></span>
      <span>Silicone heel ring</span><span class="div"></span>
      <span>Three skin-true neutrals</span>
    </div>
  </div>
</section>

<script>
(function () {
  // cutaway — hover/click a part moves the indicator line
  var parts = document.getElementById("lof-parts");
  var line = document.getElementById("lof-cut-line");
  if (parts) parts.querySelectorAll("li").forEach(function (li) {
    function activate() {
      parts.querySelectorAll("li").forEach(function (x) { x.classList.remove("on"); });
      li.classList.add("on");
      if (line) line.style.top = (18 + parseInt(li.dataset.i, 10) * 20) + "%";
    }
    li.addEventListener("mouseenter", activate);
    li.addEventListener("click", activate);
  });

  // shade match
  var row = document.getElementById("lof-skin-row");
  var skinName = document.getElementById("lof-skin-name");
  var recName = document.getElementById("lof-rec-name");
  var recDot = document.getElementById("lof-rec-dot");
  if (row) row.querySelectorAll(".lof-skin-sw").forEach(function (sw) {
    sw.addEventListener("click", function () {
      row.querySelectorAll(".lof-skin-sw").forEach(function (x) { x.classList.remove("on"); });
      sw.classList.add("on");
      if (skinName) skinName.textContent = sw.dataset.name;
      if (recName) recName.textContent = sw.dataset.rec;
      if (recDot) recDot.style.background = sw.dataset.hex;
    });
  });
})();
</script>
